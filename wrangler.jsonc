{
  // AdsBookCMS — product template.
  //
  // This file is a TEMPLATE, not a deployment. One install = one Worker = one
  // store, so every install fills this in with its own Cloudflare resources and
  // its own identity. Nothing here should ever point at somebody else's store.
  //
  // Setup, in order, is documented in INSTALLATION.md:
  //   npx wrangler d1 create <store>-d1
  //   npx wrangler kv namespace create SESSION
  //   npx wrangler r2 bucket create <store>-assets
  // then paste the printed ids below.
  //
  // Binding NAMES are fixed across every install — OMS_DB, SESSION,
  // ASSET_BUCKET, AI, ASSETS — because the application resolves them by name.
  // Only the resource names and ids differ.
  "$schema": "./node_modules/wrangler/config-schema.json",

  // Globally unique within the Cloudflare account. Placeholder values below are
  // syntactically valid so tooling runs on a fresh clone — they are NOT a target.
  "name": "zvarashop",
  "main": "./src/worker.ts",


  "compatibility_date": "2026-08-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],

  // Runtime credentials cannot safely degrade to placeholders. Declaring the
  // required names lets Wrangler load only these secrets from process.env in
  // local development and validate that every deployed Worker defines them.
  "secrets": {
    "required": [
      "AUTH_SECRET",
      "INSTALL_TOKEN",
      "MENGANTAR_API_KEY",
      "MENGANTAR_ORIGIN_AREA_ID",
      "MENGANTAR_PICKUP_ADDRESS_ID",
      "AUTOLARIS_API_KEY"
    ]
  },

  // Keep false so an install never gets an unreviewed *.workers.dev endpoint.
  "workers_dev": false,
  // Hourly evaluation catches a stalled conversion outbox even when no operator
  // opens the dashboard. Alert transitions are deduplicated in the install's KV.
  "triggers": {
    "crons": ["7 * * * *"]
  },


  "assets": {
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      // `6a63603c31ac4e328a51f323625cbfcf` until 2026-08-23, which is a
      // namespace that does not exist in this account — every deploy failed
      // with KV 10041. It was introduced by 65d1e5c, a storefront *style*
      // commit, so a config change rode in on a visual one and nothing caught
      // it until the next deploy was attempted five days later. The id below
      // is `cmsads-zvara-session`, the only zvara namespace the account has
      // and therefore the one holding live admin sessions.
      "id": "8070873504ee4bec8644a4bd7456b32a"
    }
  ],
  "d1_databases": [
    {
      "binding": "OMS_DB",
      "database_name": "zvarashop-d1",
      "database_id": "79e02ca0-1de6-4f6f-805c-495a01be88f0",
      "migrations_dir": "src/db/migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSET_BUCKET",
      "bucket_name": "zvarashop-assets"
    }
  ],
  "ai": {
    "binding": "AI"
  },

  // Without this, Workers Logs are off and the ~76 labelled console.error
  // calls in src/ are unqueryable — a failing install cannot be diagnosed
  // after the fact. See OBSERVABILITY.md.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  "routes": [
    {
      "pattern": "zvara.shop",
      "custom_domain": true
    },
    {
      "pattern": "www.zvara.shop",
      "custom_domain": true
    }
  ],

  // These are read at BUILD time through import.meta.env, not at runtime, so a
  // change here only takes effect after `npm run build`. Redeploying an already
  // built bundle with new vars changes nothing. See ARCHITECTURE.md §5.
  "vars": {
    "PUBLIC_SITE_NAME": "Zvara Shop",
    "PUBLIC_SITE_URL": "https://zvara.shop",
    // Deliberately empty, like the tagline below. A placeholder here becomes
    // the meta description Google prints under the store, and the second half
    // of the home page <title>.
    "PUBLIC_SITE_DESCRIPTION": "",
    // Deliberately empty. A non-empty default here becomes the second half of
    // every unconfigured store's <title>, which is how a fresh install came to
    // announce itself as "Toko Anda — Belum Dikonfigurasi".
    "PUBLIC_SITE_TAGLINE": "",
    "PUBLIC_ADMIN_NAME": "AdsBookCMS Admin",
    "PUBLIC_EMBED_ALLOWED_ORIGINS": "https://zvara.shop",

    // Root-relative or absolute. Replace the placeholder wordmark in
    // public/images/ with the store's own brand assets.
    "PUBLIC_SITE_LOGO": "/images/adsbook-mark.webp",

    // Must match #rrggbb or the code falls back to its own default.
    "PUBLIC_SITE_THEME_COLOR": "#111111",

    // Drives <html lang> and the Open Graph locale.
    "PUBLIC_SITE_LOCALE": "id-ID",

    // compact-market | wide-catalog. An unknown value makes every route 500.
    "PUBLIC_STOREFRONT_TEMPLATE": "compact-market",

    // Provinces excluded from cash on delivery, comma separated, lowercase.
    // This is the shipped Indonesian default; adjust per store.
    "PUBLIC_COD_DISABLED_PROVINCES": "papua,papua barat,papua barat daya,papua tengah,papua pegunungan,papua selatan,maluku,maluku utara,nusa tenggara timur,kalimantan utara,sulawesi barat,gorontalo,kepulauan riau,aceh,bengkulu"
  }
}
