    </section>

    <!-- ═══ 8. SECTION: PILIHAN PAKET & HARGA PROMO (BUNDLE BOX) ═══ -->
    <section class="w-full border-t border-slate-100 bg-[#0A192F] text-white px-4 sm:px-5 py-7 text-center">
      <div class="max-w-[420px] mx-auto space-y-4">
