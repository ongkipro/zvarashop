import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';
import '../styles/landing-pages/4g-lucky.css';

export const prerender = false;

const SLUG = '4g-lucky';
const PRODUCT_SLUG = '4g-lucky';

const formContext = await resolveFormModeContext(Astro.request);

// Product resolution with strict DB fallback
let product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) {
  product = await getStorefrontProduct(Astro.locals, '20173');
}
if (!product) {
  const allProducts = await getStorefrontProducts(Astro.locals);
  product = allProducts.find((p) => p.slug.includes('lucky') || p.slug.includes('4g')) ?? allProducts[0] ?? null;
}
if (!product) return Astro.rewrite('/404');

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const seoTitle = `${product.productName} — Kunci Durasi 60 Menit & Perkasa`;
const seoDescription =
  product.description ||
  'Spray herbal pria dewasa 4G Lucky intimate hygiene. Formula aktif anti ejakulasi dini, bikin tegak kokoh tahan lama tanpa kebas & tanpa bikin jantung berdebar. Garansi privasi rapat, bisa COD.';

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;
const bundleVariant = product.variants.find((v) => v.sku === '4GL-02') ?? product.variants[1] ?? null;
const bundlePrice = bundleVariant?.price ?? 290500;
const bundleCompare = bundleVariant?.comparePrice ?? 330000;
const productImage = product.image || '/assets/uploads/2026-10-07/5e5bea86-165f-4098-8d34-00bbee09bf3f.webp';
const socialProofOrders = await recentOrderCount(getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined);
