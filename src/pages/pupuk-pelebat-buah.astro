---
/*
 * Native Astro landing page — Pupuk Pelebat Tanaman Buah & Perangsang Bunga 250gr.
 * Rebuilt on 2026-10-18 from the live render of
 * https://zvara.shop/produk/pupuk-pelebat-buah: this page was deployed from
 * another device and its source never reached the repository. Markup and
 * page CSS are the live ones; the tracker, order form and social-proof toast
 * are the components that rendered them, and the lowest variant price is
 * bound to the product rather than written in.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';
import '../styles/landing-pages/pupuk-pelebat-buah.css';

export const prerender = false;

const SLUG = "pupuk-pelebat-buah";
const PRODUCT_SLUG = "pupuk-pelebat-buah";

const product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) return Astro.rewrite('/404');

const formContext = await resolveFormModeContext(Astro.request);
const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const seoTitle = "Pupuk Pelebat Tanaman Buah & Perangsang Bunga 250gr — Anti Rontok & Panen Lebat";
const seoDescription = "Pupuk Pelebat Tanaman Buah & Perangsang Bunga 250gr tercantum dalam kategori Agrikultur & Perkebunan. Detail yang ditampilkan mengikuti data katalog toko.";

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;
const rupiah = (value: number) => Math.round(value).toLocaleString('id-ID');
const socialProofOrders = await recentOrderCount(getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined);
