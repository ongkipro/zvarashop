      </div>
      <a
        href="#form-pemesanan"
        class="inline-flex min-h-11 items-center justify-center rounded-full bg-[#1E3A8A] px-6 text-[11px] font-bold uppercase tracking-[0.1em] text-white shadow-md transition-colors hover:bg-[#0F2942] active:scale-[0.98]"
