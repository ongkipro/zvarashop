---
/*
 * Native Astro landing page — GlowHome Pembersih Saluran Tersumbat 500ml.
 *
 * Copywriting: Punchy, Direct-Response Bahasa Indonesia (Straight to the Point).
 * Architecture: 10-Section Conversion Flow.
 * Images: 100% Lightweight WebP (Sub-50KB per asset).
 * Form: Native GeoIpResolvedForm with hybrid mode linked 1:1 to product catalog.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';
import '../styles/landing-pages/pembersih-saluran-tersumbat.css';

export const prerender = false;

const SLUG = 'pembersih-saluran-tersumbat';
const PRODUCT_SLUG = 'pemersih-saluran-tersumbat-100ml';

const product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) return Astro.rewrite('/404');

const formContext = await resolveFormModeContext(Astro.request);

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const seoTitle = 'GlowHome 500ml - Hancurkan Sumbatan Pipa, Lemak & Rambut dalam 15 Menit';
const seoDescription =
  'Saluran mampet & bau busuk? GlowHome melumatkan lemak batu dan rambut seketika tanpa bongkar pipa. Bayar di tempat (COD).';

const sectionTitle = 'text-[24px] font-bold leading-[1.18] tracking-tight text-[#0F2942]';
const body = 'text-[15px] leading-relaxed text-slate-600';
const listIcon = 'mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-[#1E3A8A]';
const dangerIcon = 'mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-[#C93A1B]';

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image="/images/landing/pembersih-saluran/pipe-action.webp"
  preloadImages="/images/landing/pembersih-saluran/pipe-action.webp"
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950 pb-20">
    <MetaLandingTracker
      slug={SLUG}
      contentId={defaultCatalogContentId(product)}
      contentName={product.contentName}
      price={price}
    />

    <!-- ═══ 1. HERO SECTION ═══ -->
    <section id="landing-hero" data-hero-section class="bg-white pb-8 text-left text-slate-950">
      <div class="px-5 pt-8">
        <h1 class="max-w-[420px] text-[30px] font-bold leading-[1.14] tracking-tight text-slate-950">
          Saluran Air Mampet? <span
            class="box-decoration-clone px-0.5 text-[#C93A1B]"
            style="background-image: linear-gradient(to top, #FFD84D 0.22em, rgba(255,216,77,0) 0.22em); background-repeat: no-repeat; background-position: 0 94%; background-size: 100% 100%;"
            >Hancurkan Lemak &amp; Rambut Seketika Tanpa Bongkar Pipa!</span
          >
        </h1>

        <p class="mt-4 max-w-[400px] text-[15px] font-semibold leading-relaxed text-slate-700">
          Wastafel mampet, toilet meluap, kamar mandi bau comberan — sekali tuang GlowHome, <span class="box-decoration-clone bg-[#FFD84D]/45 px-1 text-slate-950">sumbatan lumer lebur jadi air dalam 15 menit.</span>
        </p>
      </div>

      <!-- Hero Pipe Visual with Overlay & Ping Badge -->
      <div class="relative mt-7">
        <div
          class="relative overflow-hidden border-y border-slate-100 bg-slate-900 shadow-[0_14px_34px_rgba(30,58,138,0.12)]"
        >
          <img
            src="/images/landing/pembersih-saluran/pipe-action.webp"
            alt="Formula aktif GlowHome menghancurkan sumbatan lemak dan rambut di dalam pipa"
            class="aspect-[3/2] w-full object-cover"
            width="800"
            height="533"
            fetchpriority="high"
            decoding="async"
          />
        </div>

        <!-- Floating Glassmorphic Benefit Card -->
        <div
          class="relative z-20 mx-auto -mt-6 w-[90%] rounded-xl border border-blue-200/80 bg-white/95 p-4 text-left shadow-[0_14px_34px_rgba(30,58,138,0.14)] backdrop-blur-md"
        >
          <div class="flex gap-3">
            <span class="relative mt-1 flex h-3 w-3 shrink-0">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#1E3A8A] opacity-70"></span>
              <span
                class="relative inline-flex h-3 w-3 rounded-full bg-[#1E3A8A] shadow-[0_0_0_6px_rgba(30,58,138,0.10)]"
              ></span>
            </span>
            <div>
              <h2 class="text-[16px] font-bold leading-tight text-[#0F2942]">Sumbatan Lenyap Seketika!</h2>
              <p class="mt-1 text-[13.5px] leading-relaxed text-slate-700">
                Formula aktif melumatkan lemak beku &amp; rambut membusuk dalam 15 menit. <strong class="text-[#C93A1B]">100% aman untuk pipa PVC.</strong>
              </p>
            </div>
          </div>
        </div>

        <!-- Hero Quick Trust Strip -->
        <div class="mt-5 grid grid-cols-3 divide-x divide-slate-200 px-5 text-center">
          <div class="px-2">
            <span class="block text-[14px]">🚚</span>
            <span class="text-[11px] font-bold text-slate-800">Bisa COD</span>
            <p class="text-[10px] text-slate-500">Bayar di Tempat</p>
          </div>
          <div class="px-2">
            <span class="block text-[14px]">🛡️</span>
            <span class="text-[11px] font-bold text-slate-800">Aman Pipa</span>
            <p class="text-[10px] text-slate-500">Anti Keropos PVC</p>
          </div>
          <div class="px-2">
            <span class="block text-[14px]">⭐</span>
            <span class="text-[11px] font-bold text-slate-800">Rating 4.9/5</span>
            <p class="text-[10px] text-slate-500">Ribuan Terjual</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 2. VALUE PROPOSITION / HOOK ═══ -->
    <section class="px-5 py-10">
      <h2 class={sectionTitle}>
        Senjata Pemusnah Sumbatan: <span class="box-decoration-clone bg-[#EFF6FF] px-1.5 pb-0.5 text-[#1E3A8A]"
          >Aliran Pipa Kembali Deras Seperti Baru!</span
        >
      </h2>
      <p class={`${body} mt-2`}>
        Melarutkan kotoran sampai ke akar pipa, bukan sekadar melubangi sumbatan.
      </p>

      <div class="mt-6 grid gap-3">
        <div class="rounded-2xl border border-blue-100 bg-[#EFF6FF] p-4">
          <div class="flex gap-3">
            <span class={listIcon}><Icon name="check" class="h-4 w-4" aria-hidden="true" /></span>
            <p class={body}>
              <strong class="text-slate-950">Lumatkan Lemak, Sisa Makanan &amp; Rambut</strong> — Hancurkan gumpalan membandel di leher pipa dalam 15 menit tanpa kawat.
            </p>
          </div>
        </div>
        <div class="rounded-2xl border border-slate-100 bg-white p-4 shadow-sm">
          <div class="flex gap-3">
            <span class={listIcon}><Icon name="shield-check" class="h-4 w-4" aria-hidden="true" /></span>
            <p class={body}>
              <strong class="text-slate-950">100% Aman untuk Pipa PVC &amp; Septic Tank</strong> — Melarutkan bahan organik tanpa merusak dinding pipa plastik dan lem sambungan.
            </p>
          </div>
        </div>
        <div class="rounded-2xl border border-blue-100 bg-[#EFF6FF] p-4">
          <div class="flex gap-3">
            <span class={listIcon}><Icon name="badge-check" class="h-4 w-4" aria-hidden="true" /></span>
            <p class={body}>
              <strong class="text-slate-950">Basmi 99.9% Bakteri &amp; Lenyapkan Bau Comberan</strong> — Mensterilkan sarang kuman dan bau busuk langsung dari sumbernya.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 3. AGITATION / DANGER SIGNS ═══ -->
    <section class="border-t border-[#C93A1B]/10 bg-[#FFF7ED] px-5 py-10">
      <h2 class={sectionTitle}>
        Awas! Tanda Saluran Rumah Anda <span
          class="text-[#C93A1B] underline decoration-amber-300 decoration-4 underline-offset-4">Mampet Total &amp; Bahaya:</span>
      </h2>
      <div class="mt-6 grid gap-4">
        <div class="flex gap-3">
          <span class={dangerIcon}><Icon name="triangle-alert" class="h-4 w-4" aria-hidden="true" /></span>
          <p class={body}>
            <strong class="text-slate-950">Air Menggenang Berjam-jam:</strong> Cuci piring dan mandi terganggu karena air kotor tak kunjung surut.
          </p>
        </div>
        <div class="flex gap-3">
          <span class={dangerIcon}><Icon name="triangle-alert" class="h-4 w-4" aria-hidden="true" /></span>
          <p class={body}>
            <strong class="text-slate-950">Bau Gas Comberan Menyengat:</strong> Bau bangkai dan makanan busuk dari pipa menyebar ke seluruh ruangan rumah.
          </p>
        </div>
        <div class="flex gap-3">
          <span class={dangerIcon}><Icon name="triangle-alert" class="h-4 w-4" aria-hidden="true" /></span>
          <p class={body}>
            <strong class="text-slate-950">Sarang Kecoa &amp; Cacing Saluran:</strong> Pipa yang mampet jadi tempat berkembang biak bakteri berbahaya.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ 4. ROOT CAUSE BREAKDOWN ═══ -->
    <section class="border-t border-slate-100 px-5 py-10">
      <h2 class={sectionTitle}>
        Biang Masalah: <span class="box-decoration-clone bg-[#EFF6FF] px-1.5 pb-0.5 text-[#1E3A8A]"
          >Lemak Membatu &amp; Jeratan Rambut di Leher Pipa</span>
      </h2>
      <p class={`${body} mt-2 mb-6`}>
        Disiram air panas cuma bikin lemak pindah posisi, disogok kawat bisa bikin pipa pecah. Gumpalan minyak dan rambut membentuk sumbatan padat di belokan pipa.
      </p>

      <div class="grid gap-4">
        <figure class="relative overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
          <img
            src="/images/landing/pembersih-saluran/sink-clog-before.webp"
            alt="Wastafel dapur tergenang air kotor dan sisa makanan"
            class="aspect-[3/2] w-full object-cover"
            width="800"
            height="533"
            loading="lazy"
            decoding="async"
          />
          <figcaption
            class="absolute left-3 top-3 rounded-md bg-[#C93A1B] px-3 py-1 text-[12px] font-bold uppercase tracking-wide text-white shadow-sm"
          >
            Wastafel Dapur Mampet Lemak
          </figcaption>
        </figure>

        <figure class="relative overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
          <img
            src="/images/landing/pembersih-saluran/hair-drain.webp"
            alt="Saluran kamar mandi tersumbat gumpalan rambut membusuk"
            class="aspect-[3/2] w-full object-cover"
            width="800"
            height="533"
            loading="lazy"
            decoding="async"
          />
          <figcaption
            class="absolute left-3 top-3 rounded-md bg-[#0F2942] px-3 py-1 text-[12px] font-bold uppercase tracking-wide text-white shadow-sm"
          >
            Kamar Mandi Mampet Rambut
          </figcaption>
        </figure>
      </div>

      <p class="mt-5 text-[14px] leading-relaxed text-slate-500">
        <strong class="text-slate-950">Solusi Cepat:</strong> Cukup tuang GlowHome, tunggu 15 menit, lalu siram air. Aliran langsung plong seketika tanpa perlu panggil tukang sedot.
      </p>
    </section>

    <!-- ═══ 5. DARK CONTRAST SECTION (BEFORE & AFTER + CARA PAKAI) ═══ -->
    <section class="border-t border-slate-900 bg-[#0B1E36] px-5 py-10 text-white">
      <h2 class="text-[26px] font-bold leading-[1.14] tracking-tight text-white">
        Hasil Nyata: <span class="text-[#93C5FD]">Sumbatan Lenyap, Air Mengalir Deras</span>
      </h2>
      <p class="mt-2 mb-6 text-[15px] leading-relaxed text-slate-300">
        Lihat perubahan saluran air sebelum dan sesudah dibersihkan dengan GlowHome:
      </p>

      <div class="-mx-5 grid gap-4">
        <div class="relative overflow-hidden bg-slate-900">
          <img
            src="/images/landing/pembersih-saluran/sink-clog-before.webp"
            alt="Kondisi Sebelum Menggunakan GlowHome"
            class="aspect-[3/2] w-full object-cover"
            width="800"
            height="533"
            loading="lazy"
            decoding="async"
          />
          <div
            class="absolute left-4 top-4 rounded bg-[#C93A1B] px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-white shadow"
          >
            Sebelum: Mampet Total &amp; Bau Busuk
          </div>
        </div>

        <div class="relative overflow-hidden bg-slate-900">
          <img
            src="/images/landing/pembersih-saluran/sink-clean-after.webp"
            alt="Hasil Setelah Menggunakan GlowHome"
            class="aspect-[3/2] w-full object-cover"
            width="800"
            height="533"
            loading="lazy"
            decoding="async"
          />
          <div
            class="absolute left-4 top-4 rounded bg-[#16A34A] px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-white shadow"
          >
            Setelah: Lancar Deras Seperti Baru!
          </div>
        </div>
      </div>

      <div class="mt-8 border-t border-slate-700/60 pt-7">
        <h3 class="text-[19px] font-bold text-white mb-4">3 Langkah Mudah Pemakaian:</h3>
        <div class="grid gap-4">
          <div class="flex gap-3">
            <span
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[#93C5FD] text-[14px] font-bold text-slate-950"
              >1</span
            >
            <p class="text-[15px] leading-relaxed text-slate-300">
              <strong class="text-white">Keringkan Genangan:</strong> Bersihkan sisa air di atas lubang pembuangan agar cairan langsung masuk ke titik sumbatan.
            </p>
          </div>
          <div class="flex gap-3">
            <span
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[#93C5FD] text-[14px] font-bold text-slate-950"
              >2</span
            >
            <p class="text-[15px] leading-relaxed text-slate-300">
              <strong class="text-white">Tuangkan GlowHome:</strong> Tuangkan 150–200ml cairan konsentrat langsung ke dalam lubang pipa.
            </p>
          </div>
          <div class="flex gap-3">
            <span
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[#93C5FD] text-[14px] font-bold text-slate-950"
              >3</span
            >
            <p class="text-[15px] leading-relaxed text-slate-300">
              <strong class="text-white">Tunggu 15 Menit &amp; Bilas:</strong> Biarkan formula melarutkan kotoran, lalu siram air deras. Saluran langsung lancar!
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 6. INFOGRAPHIC KEUNGGULAN ═══ -->
    <section class="border-t border-slate-100 bg-[#F8FAFC] px-5 py-8">
      <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm">
        <img
          src="/images/landing/pembersih-saluran/benefits.webp"
          alt="Keunggulan GlowHome: Mudah digunakan, formula ampuh, kualitas premium"
          class="w-full h-auto object-cover"
          width="800"
          height="1333"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>

    <!-- ═══ 7. TESTIMONIALS (PETANI SEJAHTERA OPEN EDITORIAL PATTERN) ═══ -->
    <section class="border-t border-slate-100 px-5 py-10">
      <div class="mb-8">
        <span class="inline-block rounded-md bg-[#EFF6FF] px-2.5 py-1 text-[11px] font-bold uppercase tracking-widest text-[#1E3A8A] ring-1 ring-[#1E3A8A]/15 mb-2">
          Pengalaman Nyata Pelanggan
        </span>
        <h2 class={sectionTitle}>
          Bukti Nyata Pelanggan: <span class="box-decoration-clone bg-[#EFF6FF] px-1.5 pb-0.5 text-[#1E3A8A]"
            >Saluran Bersih &amp; Plong Seketika</span
          >
        </h2>
        <p class={`${body} mt-2`}>
          Cerita jujur dari pelanggan di berbagai kota setelah memakai formula aktif GlowHome:
        </p>
      </div>

      <div class="space-y-9">
        {
          [
            {
              name: 'Ibu Rina Mariana',
              location: 'Surabaya, Jawa Timur',
              avatar: '/images/landing/pembersih-saluran/testi-ibu.webp',
              problem: 'Wastafel Dapur • Masalah: Minyak Goreng Beku & Bau Busuk',
              image: '/images/landing/pembersih-saluran/testi-proof-sink.webp',
              imageCaption: 'Hasil nyata: Wastafel cuci piring plong, air mengalir lancar seketika',
              review:
                'Sink cuci piring saya udah seminggu <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 text-slate-950 font-semibold">mampet total gara-gara minyak goreng beku menumpuk</strong>. Pas saya tuang GlowHome malam hari, suaranya langsung berdesis bereaksi. Paginya disiram air panas <strong class="box-decoration-clone bg-[#EFF6FF] px-1.5 pb-0.5 text-[#1E3A8A] font-semibold">langsung plong jebol seketika tanpa sisa!</strong> Gila ini ampuh banget, gak perlu panggil tukang ledeng.',
              takeaway: 'Minyak beku lumer lebur total, aliran sink kembali lancar deras tanpa bongkar pipa.',
            },
            {
              name: 'Pak Budi Santoso',
              location: 'Bekasi, Jawa Barat',
              avatar: '/images/landing/pembersih-saluran/testi-bapak.webp',
              problem: 'Kamar Mandi • Masalah: Floor Drain Meluap Rambut Rontok',
              image: '/images/landing/pembersih-saluran/testi-proof-drain.webp',
              imageCaption: 'Hasil nyata: Floor drain bersih, air mandi surut cepat tanpa genangan',
              review:
                'Drain lantai kamar mandi utama <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 text-slate-950 font-semibold">selalu banjir setinggi mata kaki tiap ada yang mandi</strong> karena rambut rontok terikat di leher pipa P-trap. Dituang GlowHome setengah botol, didiamkan 20 menit, <strong class="box-decoration-clone bg-[#EFF6FF] px-1.5 pb-0.5 text-[#1E3A8A] font-semibold">gumpalan rambut gimbalnya langsung larut mencair jadi air!</strong> Air mandi sekarang surut secepat kilat.',
              takeaway: 'Gumpalan rambut rontok larut 100%, drain lantai kembali normal tanpa genangan.',
            },
            {
              name: 'Hendra Kurniawan',
              location: 'Bandung, Jawa Barat',
              avatar: '/images/landing/pembersih-saluran/testi-pria.webp',
              problem: 'Pipa Toilet & WC • Masalah: Saluran Lambat & Bau Menyengat',
              image: '/images/landing/pembersih-saluran/testi-proof-toilet.webp',
              imageCaption: 'Hasil nyata: Saluran toilet bersih segar, bebas bau busuk menahun',
              review:
                'Pipa toilet rumah saya sering keluar <strong class="box-decoration-clone bg-red-100 px-1.5 pb-0.5 text-slate-950 font-semibold">bau busuk comberan menyengat seperti bangkai tikus</strong> dan siramannya lambat turun. Dituangin GlowHome sekali, <strong class="box-decoration-clone bg-[#EFF6FF] px-1.5 pb-0.5 text-[#1E3A8A] font-semibold">baunya hilang lenyap 100% dan saluran lancar jaya</strong>. Ini cairan wajib punya tiap rumah tangga!',
              takeaway: 'Membasmi 99.9% kuman dan menghilangkan bau busuk langsung ke sumbernya.',
            },
          ].map((item, index, arr) => (
            <div class="space-y-3.5">
              <!-- Customer Header -->
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <img
                    src={item.avatar}
                    alt={`Foto ${item.name}`}
                    class="h-12 w-12 rounded-full object-cover ring-2 ring-slate-100 shrink-0"
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                  />
                  <div>
                    <div class="flex items-center gap-1.5">
                      <h3 class="text-[16px] font-bold text-slate-950">{item.name}</h3>
                      <span class="flex h-4 w-4 items-center justify-center text-blue-600">
                        <Icon name="badge-check" class="h-4 w-4" aria-hidden="true" />
                      </span>
                    </div>
                    <p class="text-[12px] font-medium text-slate-500">{item.location}</p>
                  </div>
                </div>
                <div class="shrink-0 text-[13px] text-[#FBBF24]" role="img" aria-label="5 dari 5 bintang">
                  ★★★★★
                </div>
              </div>

              <!-- Problem Pill -->
              <div class="inline-block rounded-md px-2.5 py-1 text-[11px] font-semibold tracking-wide border border-slate-200/70 bg-slate-50 text-slate-700">
                {item.problem}
              </div>

              <!-- Proof Photo with Aspect 16/9 -->
              <div class="relative aspect-[16/9] w-full overflow-hidden rounded-xl border border-slate-200/80 shadow-sm">
                <img
                  src={item.image}
                  alt={item.imageCaption}
                  class="h-full w-full object-cover"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <!-- Quote with Highlighted Spans and Left Border Accent -->
              <p
                class="border-l-2 border-[#1E3A8A]/35 pl-3.5 text-[15px] leading-relaxed text-slate-700 italic pt-0.5"
                set:html={`“${item.review}”`}
              />

              <!-- Key Takeaway Box -->
              <div class="flex items-center gap-2 rounded-lg bg-[#EFF6FF] px-3 py-2 text-[12px] font-semibold text-[#1E3A8A]">
                <span>📌</span>
                <span>{item.takeaway}</span>
              </div>

              {index < arr.length - 1 && (
                <div class="pt-6">
                  <div class="h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent" />
                </div>
              )}
            </div>
          ))
        }
      </div>
    </section>

    <!-- ═══ 8. GARANSI 100% BELANJA AMAN ═══ -->
    <section class="border-t border-[#0F2942] bg-[#0F2942] px-5 py-10 text-center text-white">
      <div class="mx-auto mb-5 flex h-16 w-16 items-center justify-center text-[#FBBF24]">
