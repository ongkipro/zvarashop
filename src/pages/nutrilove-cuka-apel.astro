        class="inline-flex min-h-11 items-center justify-center rounded-full border border-[#0F2F1F] bg-[#0F2F1F] px-6 text-[11px] font-bold uppercase tracking-wider text-white transition-colors hover:bg-emerald-900 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0F2F1F] active:scale-[0.98]"
