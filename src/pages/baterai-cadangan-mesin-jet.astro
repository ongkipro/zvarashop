                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.12 2.12 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.12 2.12 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.12 2.12 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.12 2.12 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.12 2.12 0 0 0 1.597-1.16z"
                ></path></svg></div></div
          ><p class="mt-1.5 text-[13.5px] font-normal leading-relaxed text-slate-900"
            >"Langsung ambil paket Beli 2 biar pas satu dipakai yang satu dicas.{' '}<mark
              class="bg-amber-200/80 px-1 font-semibold text-slate-950"
              >Semburan air jet cleaner jadi jauh lebih nendang</mark
            >{' '}kayak baru beli mesin baru!"</p
          ></article
        ></div
      ></section
    ><!-- ═══ 5. 3 CONCISE FAQ ITEMS ═══ --><section
      class="cv-section border-t border-slate-200 bg-white pt-7 pb-7 px-5 text-left"
      ><h2 class="text-[20px] font-bold tracking-tight leading-[1.2] text-slate-950">Pertanyaan yang Sering Diajukan</h2
      ><div class="mt-3 divide-y divide-slate-200 border-y border-slate-200"
        ><div class="py-3.5"
          ><h3 class="text-[14px] font-bold text-slate-950">Alat apa saja yang cocok menggunakan baterai 48VF ini?</h3
          ><p class="mt-1 text-[13px] font-normal leading-relaxed text-slate-700"
            >Cocok untuk mesin cuci mobil jet cleaner cordless, bor baterai, impact wrench, gerinda tangan, dan mesin potong
            rumput dengan dudukan slot LXT universal.</p
          ></div
        ><div class="py-3.5"
          ><h3 class="text-[14px] font-bold text-slate-950">Apakah bisa dicas menggunakan charger bawaan mesin saya?</h3
          ><p class="mt-1 text-[13px] font-normal leading-relaxed text-slate-700"
            >Bisa, baterai ini mendukung pengisian menggunakan charger adaptor tusuk maupun desktop dock standar baterai
            lithium 21V-48VF.</p
          ></div
        ><div class="py-3.5"
          ><h3 class="text-[14px] font-bold text-slate-950">Apakah bisa bayar di tempat (COD) saat paket datang?</h3
          ><p class="mt-1 text-[13px] font-normal leading-relaxed text-slate-700"
            >Bisa, Anda cukup mengisi alamat di bawah ini dan bayar tunai langsung ke kurir saat barang tiba.</p
          ></div
        ></div
      ></section
    ><!-- ═══ 6. MECHANISM ACTION IMAGE & URGENCY PRICING STRIP ═══ --><section
      class="cv-section w-full border-t border-slate-900 bg-slate-950 text-white pb-7 text-left"
      ><div class="px-5 pt-6"
        ><div class="flex items-center justify-between pb-4 border-b border-slate-800"
          ><span class="inline-flex items-center gap-1.5 text-[12px] font-bold uppercase tracking-wider text-amber-400"
            ><svg
              xmlns="http://www.w3.org/2000/svg"
              width="1em"
              height="1em"
              viewBox="0 0 24 24"
              class="h-4 w-4 text-amber-400"
              aria-hidden="true"
              fill="none"
              stroke="currentColor"
            >
              <g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2">
                <circle cx="12" cy="12" r="10"></circle>
                <path d="M12 6v6l4 2"></path>
              </g></svg
            ><span>Promo Berakhir Dalam</span></span
          ><div class="font-mono text-[16px] font-bold text-white"
            ><span id="countdown-minutes">15</span>:<span id="countdown-seconds">00</span></div
          ></div
        ><div class="py-4 border-b border-slate-800"
          ><p class="text-[11px] font-bold uppercase tracking-widest text-slate-400"
            >Harga Promo Paket 2 Baterai (Paling Diminati)</p
          ><div class="mt-1.5 flex items-baseline gap-2.5"
            ><span class="text-[32px] font-bold font-mono tracking-tight text-amber-400 leading-none">Rp141.000</span
            ><span class="text-[14px] text-slate-400 line-through">Rp160.000</span></div
          ><p class="mt-2 text-[12.5px] font-semibold text-slate-200">Hemat Rp19.000 • Beli 1 Rp{rupiah(price)}</p></div
        ><div class="pt-4"
          ><div class="flex items-center justify-between text-[12px] font-semibold"
            ><span class="text-slate-300">Sisa Kuota Promo Hari Ini:</span
            ><span id="stock-count-text" class="font-mono font-bold text-amber-400">Tersisa 8 Unit Lagi</span></div
          ><div class="mt-2 h-1.5 w-full bg-slate-800 overflow-hidden"
            ><div
              id="stock-progress-bar"
              class="h-full bg-amber-400 transition-all duration-500"
              style="width: 55%"
            ></div></div></div></div></section
    ><!-- ═══ 7. FORMULIR PEMESANAN (CHECKOUT COD) ═══ --><section
      id="form-pemesanan"
      class="bg-white px-0 pt-6 pb-4 scroll-mt-4 w-full text-left"
      ><div class="px-5 pb-2"
        ><h2 class="text-[20px] font-bold tracking-tight text-slate-950 leading-tight">Lengkapi Data Pengiriman COD</h2
        ><p class="text-[13.5px] font-normal text-slate-600 mt-1 leading-relaxed"
          >Pilih paket dan isi alamat. Bayar tunai langsung ke kurir saat barang sampai di tangan Anda.</p
        ></div
      ><GeoIpResolvedForm mode={formContext.mode} province={formContext.province} productSlug={product.slug} embedded={true} /></section
    ><SocialProofToast orderCount={socialProofOrders} heroSelector="#landing-hero" formSelector="#form-pemesanan" /><div
      id="sticky-purchase-bar"
      class="fixed inset-x-0 bottom-0 z-40 mx-auto flex w-full max-w-[480px] items-center justify-between border-t border-slate-200 bg-white/95 px-4 py-3 backdrop-blur-md transition-all duration-300 lg:hidden"
      style="transform: translateY(100%); opacity: 0; pointer-events: none"
      ><div
        ><p class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">Mulai Dari</p
        ><p class="text-base font-bold text-slate-950">Rp{rupiah(price)}</p></div
      ><a
        href="#form-pemesanan"
        class="inline-flex min-h-11 items-center justify-center bg-red-700 px-5 text-[11.5px] font-bold uppercase tracking-wider text-white transition-colors hover:bg-red-800"
        >Pesan Sekarang (COD)</a
      ></div
    >
  </main>
  <script is:inline>
  function initCountdownTimer() {
    const minEl = document.getElementById('countdown-minutes');
    const secEl = document.getElementById('countdown-seconds');
    if (!minEl || !secEl) return;

    const DURATION_MS = 15 * 60 * 1000;
    const STORAGE_KEY = 'baterai_jet_countdown_v1';
    let targetTime = parseInt(sessionStorage.getItem(STORAGE_KEY) || '0', 10);
    const now = Date.now();

    if (!targetTime || targetTime <= now || targetTime - now > DURATION_MS) {
      targetTime = now + DURATION_MS;
      sessionStorage.setItem(STORAGE_KEY, targetTime.toString());
    }

    const updateTimer = () => {
      const currentTime = Date.now();
      let remainingMs = targetTime - currentTime;

      if (remainingMs <= 0) {
        targetTime = currentTime + DURATION_MS;
        sessionStorage.setItem(STORAGE_KEY, targetTime.toString());
        remainingMs = DURATION_MS;
      }

      const totalSeconds = Math.floor(remainingMs / 1000);
      const mins = Math.floor(totalSeconds / 60);
      const secs = totalSeconds % 60;

      minEl.textContent = String(mins).padStart(2, '0');
      secEl.textContent = String(secs).padStart(2, '0');
    };

    updateTimer();
    setInterval(updateTimer, 1000);
  }

  function initStockCounter() {
    const stockText = document.getElementById('stock-count-text');
    const stockBar = document.getElementById('stock-progress-bar');
    if (!stockText || !stockBar) return;

    const STORAGE_KEY = 'baterai_jet_stock_v1';
    let stock = parseInt(sessionStorage.getItem(STORAGE_KEY) || '0', 10);

    if (!stock || stock < 4 || stock > 12) {
      stock = Math.floor(Math.random() * (12 - 6 + 1)) + 6;
      sessionStorage.setItem(STORAGE_KEY, stock.toString());
    }

    const updateStockUI = (val) => {
      stockText.textContent = `Tersisa ${val} Unit Lagi`;
      const pct = Math.min(90, Math.max(30, Math.round((val / 15) * 100)));
      stockBar.style.width = `${pct}%`;
    };

    updateStockUI(stock);

    const delay = Math.floor(Math.random() * (60000 - 35000 + 1)) + 35000;
    setTimeout(() => {
      let current = parseInt(sessionStorage.getItem(STORAGE_KEY) || '0', 10);
      if (current > 3) {
        current -= 1;
        sessionStorage.setItem(STORAGE_KEY, current.toString());
        updateStockUI(current);
      }
    }, delay);
  }

  function initStickyBarObserver() {
    const stickyBar = document.getElementById('sticky-purchase-bar');
    const orderForm = document.getElementById('form-pemesanan');
    const hero = document.getElementById('landing-hero');
    if (!stickyBar || !orderForm) return;

    let heroVisible = true;
    let formVisible = false;

    const applyStickyVisibility = () => {
      if (heroVisible || formVisible) {
        stickyBar.style.transform = 'translateY(100%)';
        stickyBar.style.opacity = '0';
        stickyBar.style.pointerEvents = 'none';
      } else {
        stickyBar.style.transform = 'translateY(0)';
        stickyBar.style.opacity = '1';
        stickyBar.style.pointerEvents = 'auto';
      }
    };

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.target === hero) heroVisible = entry.isIntersecting;
          if (entry.target === orderForm) formVisible = entry.isIntersecting;
        });
        applyStickyVisibility();
      },
      { threshold: 0, rootMargin: '0px 0px -40px 0px' }
    );

    if (hero) observer.observe(hero);
    else heroVisible = false;
    observer.observe(orderForm);
    applyStickyVisibility();
  }

  const initAll = () => {
    initCountdownTimer();
    initStockCounter();
    initStickyBarObserver();
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }
</script>
</BaseLayout>
