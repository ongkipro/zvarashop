          width="1024"
          height="1024"
        />
      </div>

      <!-- Clean Mobile Comparison Stack -->
      <div class="mt-4 space-y-2.5">
        <div class="rounded-xl border border-rose-200/90 bg-rose-50/50 p-3 text-left">
          <div class="flex items-center gap-1.5">
            <span class="flex h-4 w-4 items-center justify-center rounded-full bg-rose-200/80 text-[10px] font-bold text-rose-700">✕</span>
            <span class="font-bold text-[11.5px] uppercase tracking-wider text-rose-800">Minyak Kemiri Oplosan / Minyak Curah</span>
