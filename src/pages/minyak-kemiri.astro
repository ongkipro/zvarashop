    <!-- ═══ 3. PENYEBAB & AREA PENGGUNAAN ═══ -->
    <section class="border-t border-slate-200 bg-slate-50/70 px-4 sm:px-5 py-6 sm:py-8 text-left">
      <div class="mb-3.5">
        <span class="text-[10.5px] font-bold uppercase tracking-wider text-[#0A2540]">Nutrisi Folikel Intensif</span>
        <h2 class="mt-1 text-[clamp(18px,5vw,21px)] font-bold leading-snug tracking-tight text-slate-900">
