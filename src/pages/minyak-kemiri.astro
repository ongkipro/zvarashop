    <section id="promo-box" class="border-t border-slate-200 bg-[#0A2540] px-4 sm:px-5 py-6 sm:py-8 text-center text-white">
      <span class="inline-block rounded-full border border-white/20 bg-white/10 px-2.5 py-0.5 text-[9.5px] sm:text-[10px] font-bold uppercase tracking-wider text-amber-300">
        Penawaran Terbatas
      </span>

      <h2 class="mt-2 text-[clamp(19px,5.5vw,22px)] font-bold tracking-tight text-white">
        PILIH PAKET MINYAK KEMIRI BAKAR 100ML
      </h2>
      <p class="mt-1 text-[12.5px] text-slate-300">
        Khusus Pemesanan Hari Ini — Bonus Kuas Spoolie &amp; Bisa COD
      </p>

      <!-- Bundle Package Showcase Image (Frameless) -->
      <div class="mt-4 -mx-4 sm:-mx-5 overflow-hidden">
        <img
          src="/images/landing/minyak-kemiri/bundle-pack.webp"
          alt="Paket Hemat 3 Botol Minyak Kemiri Bakar Murni 100ml lengkap dengan kuas spoolie dan biji kemiri"
          class="aspect-square w-full object-cover block"
          loading="lazy"
          decoding="async"
          width="1024"
          height="1024"
        />
      </div>

      <!-- Price Display -->
      <div class="mt-3.5 flex items-center justify-center gap-2.5">
        <span class="text-[13px] text-slate-300 line-through">Rp{comparePrice.toLocaleString('id-ID')}</span>
        <span class="text-[26px] font-bold text-amber-400">Rp{Math.round(price).toLocaleString('id-ID')}</span>
      </div>

      <!-- 15-Minute Countdown Timer -->
      <div class="mx-auto mt-3.5 max-w-[320px] rounded-xl border border-white/15 bg-white/10 p-2.5 sm:p-3">
        <p class="text-[11px] font-semibold text-slate-300">Promo Berakhir Dalam:</p>
        <div class="mt-1.5 flex items-center justify-center gap-2 font-mono">
          <div class="flex flex-col items-center">
            <span id="countdown-minutes" class="flex h-10 w-11 items-center justify-center rounded bg-slate-950 text-[18px] font-bold text-amber-400">14</span>
            <span class="mt-0.5 text-[8.5px] uppercase tracking-wider text-slate-200">Menit</span>
          </div>
          <span class="text-[18px] font-bold text-amber-400">:</span>
          <div class="flex flex-col items-center">
            <span id="countdown-seconds" class="flex h-10 w-11 items-center justify-center rounded bg-slate-950 text-[18px] font-bold text-amber-400">59</span>
            <span class="mt-0.5 text-[8.5px] uppercase tracking-wider text-slate-200">Detik</span>
          </div>
        </div>
      </div>

      <!-- Stock Scarcity Progress Bar -->
      <div class="mx-auto mt-3 max-w-[320px] text-left">
        <div class="flex justify-between text-[10.5px] font-bold text-slate-300">
          <span id="stock-count-text">Tersisa 9 Botol Lagi</span>
          <span class="text-amber-400">Stok Terbatas</span>
        </div>
        <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-white/20">
          <div
            id="stock-progress-bar"
            class="h-full rounded-full bg-amber-400 transition-all duration-500"
            style="width: 58%;"
          ></div>
        </div>
      </div>
    </section>

    <!-- ═══ 8. FORMULIR PEMESANAN RESMI (CHECKOUT) ═══ -->
