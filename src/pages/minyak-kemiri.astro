      <div class="mt-3.5 grid grid-cols-2 gap-2 sm:gap-2.5">
        <div class="rounded-xl border border-slate-200/90 bg-white p-2.5 sm:p-3 shadow-xs">
          <span class="flex items-center gap-1.5 text-[11.5px] sm:text-[12.5px] font-bold text-slate-900 mb-1.5">
            <span class="h-1.5 w-1.5 rounded-full bg-[#0A2540] shrink-0"></span>
            Area Penggunaan:
          </span>
          <ul class="space-y-1 text-[11px] sm:text-[12px] text-slate-600 leading-snug">
