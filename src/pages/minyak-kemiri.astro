      <!-- Oil Texture Droplet Asset Showcase -->
      <div class="-mx-4 sm:-mx-5 overflow-hidden">
        <img
          src="/images/landing/minyak-kemiri/oil-texture.webp"
          alt="Tekstur kental pekat Minyak Kemiri Bakar murni menetes dengan warna gelap keemasan kaya nutrisi"
