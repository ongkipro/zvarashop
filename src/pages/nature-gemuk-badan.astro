---
/*
 * Native Astro landing page — Nature Gemuk Badan Isi 60 Kapsul.
 * Clean, High-Converting Direct-Response Funnel
 * Exact Visual & Structural Reference: https://zvara.shop/pembersih-kerak-panci
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { getStorefrontProduct, getStorefrontProducts } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';
import '../styles/landing-pages/nature-gemuk-badan.css';

export const prerender = false;

const SLUG = 'nature-gemuk-badan';
const PRODUCT_SLUG = 'nature-gemuk-badan-isi-60-kapsul';

// Product resolution with strict DB fallback
let product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) {
  const allProducts = await getStorefrontProducts(Astro.locals);
  product = allProducts.find((p) => p.slug.includes('gemuk')) ?? allProducts[0] ?? null;
}
if (!product) return Astro.rewrite('/404');

const formContext = await resolveFormModeContext(Astro.request);

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const seoTitle = 'Nature Gemuk Badan Isi 60 Kapsul — Penggemuk Badan Alami Resmi BPOM';
const seoDescription =
  'Nature Gemuk Badan isi 60 kapsul (POM TR.183 314 351). Tingkatkan nafsu makan, optimalkan penyerapan nutrisi pencernaan, dan capai berat badan ideal secara sehat. Bisa COD!';

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;
const comparePrice = cheapest?.comparePrice ?? Math.round(price * 1.12);
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image="/images/landing/nature-gemuk-badan/hero-lifestyle.webp"
  preloadImages="/images/landing/nature-gemuk-badan/hero-lifestyle.webp"
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-12 font-sans text-slate-900 shadow-2xl selection:bg-[#0F766E] selection:text-white antialiased">
    <MetaLandingTracker
      slug={SLUG}
      contentId={defaultCatalogContentId(product)}
      contentName={product.contentName}
      price={price}
    />

    <!-- ═══ 1. URGENCY ANNOUNCEMENT BAR (TOP) ═══ -->
    <header class="flex items-center justify-between border-b border-cyan-950 bg-[#083344] px-4 py-2.5 text-white shadow-sm">
      <div class="flex items-center gap-2 text-[12px] font-bold tracking-wide">
        <span class="flex h-2 w-2 relative">
