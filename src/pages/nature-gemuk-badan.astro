        class="inline-flex min-h-[44px] items-center justify-center rounded-xl bg-gradient-to-r from-teal-600 to-cyan-600 px-6 text-[13px] font-bold uppercase tracking-[0.06em] text-white shadow-sm transition-all hover:brightness-105 active:scale-[0.98]"
      >
        Pesan Sekarang (COD)
      </a>
    </div>

    <!-- Social Proof Toast - Blocked on #landing-hero so it only shows after scrolling down! -->
    <SocialProofToast
      productLabel="Nature Gemuk Badan Isi 60 Kapsul"
      productImage="/images/landing/nature-gemuk-badan/product-bottle.webp"
      heroSelector="#landing-hero"
      formSelector="#form-pemesanan"
    />
  </main>

  <script slot="head" is:inline>
    function initStickyBarObserver() {
      const stickyBar = document.getElementById('sticky-purchase-bar');
      const orderForm = document.getElementById('form-pemesanan');
      const hero = document.getElementById('landing-hero');
      if (!stickyBar) return;

      let heroVisible = true;
      let formVisible = false;

      const applyStickyVisibility = () => {
        if (heroVisible || formVisible) {
          stickyBar.style.transform = 'translateY(100%)';
          stickyBar.style.opacity = '0';
          stickyBar.style.pointerEvents = 'none';
        } else {
          stickyBar.style.transform = 'translateY(0)';
          stickyBar.style.opacity = '1';
          stickyBar.style.pointerEvents = 'auto';
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.target === hero) heroVisible = entry.isIntersecting;
            if (entry.target === orderForm) formVisible = entry.isIntersecting;
          });
          applyStickyVisibility();
        },
        { threshold: 0.05, rootMargin: '0px 0px -40px 0px' }
      );

      if (hero) observer.observe(hero);
      if (orderForm) observer.observe(orderForm);
      applyStickyVisibility();
    }

    function initCountdownTimer() {
      const minEl = document.getElementById('countdown-minutes');
      const secEl = document.getElementById('countdown-seconds');
      if (!minEl || !secEl) return;

      const DURATION_MS = 15 * 60 * 1000; // 15 rolling minutes
      const STORAGE_KEY = 'nature_gemuk_countdown_v3';
      let targetTime = parseInt(sessionStorage.getItem(STORAGE_KEY) || '0', 10);
      const now = Date.now();

      if (!targetTime || targetTime <= now || targetTime - now > DURATION_MS) {
        targetTime = now + DURATION_MS;
        sessionStorage.setItem(STORAGE_KEY, targetTime.toString());
      }

      const updateTimer = () => {
        const currentTime = Date.now();
        let remainingMs = targetTime - currentTime;

        if (remainingMs <= 0) {
          targetTime = currentTime + DURATION_MS;
          sessionStorage.setItem(STORAGE_KEY, targetTime.toString());
          remainingMs = DURATION_MS;
        }

        const totalSeconds = Math.floor(remainingMs / 1000);
        const mins = Math.floor(totalSeconds / 60);
        const secs = totalSeconds % 60;

        minEl.textContent = String(mins).padStart(2, '0');
        secEl.textContent = String(secs).padStart(2, '0');
      };

      updateTimer();
      setInterval(updateTimer, 1000);
    }

    function initStockCounter() {
      const stockText = document.getElementById('stock-count-text');
      const stockBar = document.getElementById('stock-progress-bar');
      if (!stockText || !stockBar) return;

      const STORAGE_KEY = 'nature_gemuk_stock_v3';
      let stock = parseInt(sessionStorage.getItem(STORAGE_KEY) || '0', 10);

      // Lock per session within 8 - 18 random range
      if (!stock || stock < 8 || stock > 18) {
        stock = Math.floor(Math.random() * (18 - 8 + 1)) + 8;
        sessionStorage.setItem(STORAGE_KEY, stock.toString());
      }

      const updateStockUI = (val) => {
        stockText.textContent = `Tersisa ${val} Botol Lagi`;
        const pct = Math.min(92, Math.max(30, Math.round((val / 20) * 100)));
        stockBar.style.width = `${pct}%`;
      };

      updateStockUI(stock);

      // Subtle organic live decrement after 35-65 seconds if user stays on page
      const delay = Math.floor(Math.random() * (65000 - 35000 + 1)) + 35000;
      setTimeout(() => {
        let current = parseInt(sessionStorage.getItem(STORAGE_KEY) || '0', 10);
        if (current > 5) {
          current -= 1;
          sessionStorage.setItem(STORAGE_KEY, current.toString());
          updateStockUI(current);
        }
      }, delay);
    }

    const initAll = () => {
      initStickyBarObserver();
      initCountdownTimer();
      initStockCounter();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAll);
    } else {
      initAll();
    }
  </script>
</BaseLayout>
