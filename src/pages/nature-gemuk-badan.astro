    <!-- ═══ 9. PENAWARAN KHUSUS & URGENCY PROMO ═══ -->
    <section class="w-full border-t border-slate-100 bg-[#083344] text-white px-4 sm:px-5 py-7 text-center">
      <div class="max-w-[420px] mx-auto space-y-4">
        <!-- Countdown Timer Bar -->
        <div class="flex items-center justify-between bg-white/10 backdrop-blur-xs rounded-xl px-4 py-2.5 border border-white/15">
          <div class="flex items-center gap-2 text-[12.5px] font-bold text-slate-100">
            <svg class="h-4 w-4 text-amber-300 shrink-0 fill-none stroke-current stroke-2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
            <span>Promo Berakhir Dalam:</span>
          </div>
          <div class="flex items-center gap-1.5 font-mono font-bold text-[14px]">
