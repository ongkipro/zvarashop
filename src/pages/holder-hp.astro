---
/*
 * Native Astro landing page — Holder HP Spion Motor Besi Tangguh.
 *
 * Architecture: 10-Section High-Converting Editorial Funnel.
 * Performance: 100% Lightweight WebP (Sub-70KB per asset).
 * Form: Native GeoIpResolvedForm with hybrid COD mode linked to product catalog.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import Icon from '../components/storefront/shared/Icon.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';
import '../styles/landing-pages/holder-hp.css';

export const prerender = false;

const SLUG = 'holder-hp';
const PRODUCT_SLUG = 'holder-hp';

const product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) return Astro.rewrite('/404');

const formContext = await resolveFormModeContext(Astro.request);

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const seoTitle = 'Holder HP Spion Motor Besi Tangguh — Kokoh Anti Getar, Pengunci Rotary Lock Presisi';
const seoDescription =
  'Holder HP spion motor bahan besi alloy tebal anti goyang dan anti getar di jalan rusak. Pas untuk semua motor matic, bebek, dan sport. Bisa COD.';

const sectionTitle = 'text-[24px] font-bold leading-[1.18] tracking-tight text-[#0F2942]';
const body = 'text-[15px] leading-relaxed text-slate-600';
const listIcon = 'mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-[#1E3A8A]';
const dangerIcon = 'mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center text-[#C93A1B]';

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;
const socialProofOrders = await recentOrderCount(getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined);
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image="/images/landing/holder-hp/hero-action.webp"
  preloadImages="/images/landing/holder-hp/hero-action.webp"
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white text-slate-950 pb-20 font-sans antialiased">
    <MetaLandingTracker
      slug={SLUG}
      contentId={defaultCatalogContentId(product)}
      contentName={product.contentName}
      price={price}
    />

    <!-- ═══ 1. TOP ANNOUNCEMENT BAR ═══ -->
    <div class="bg-neutral-950 px-4 py-2.5 text-center text-white">
      <p class="text-[12px] font-medium tracking-wide">
        🔥 <span class="font-bold text-amber-300">PROMO SPESIAL HARI INI</span> — Diskon Terbatas &amp; Bisa <span class="font-bold underline text-white">COD (Bayar di Tempat)</span>
      </p>
    </div>

    <!-- ═══ 2. HERO SECTION ═══ -->
    <section id="landing-hero" data-hero-section class="bg-white pb-8 text-left text-slate-950">
      <div class="px-5 pt-8">
        <span class="inline-block rounded-full bg-amber-100 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-amber-900 mb-2">
          Solusi Navigasi GPS Motor Aman &amp; Kokoh
        </span>
        <h1 class="max-w-[420px] text-[28px] font-bold leading-[1.15] tracking-tight text-slate-950">
          HP Sering Goyang &amp; Takut Jatuh Saat Bawa Motor? <span
            class="box-decoration-clone px-0.5 text-[#C93A1B]"
            style="background-image: linear-gradient(to top, #FFD84D 0.22em, rgba(255,216,77,0) 0.22em); background-repeat: no-repeat; background-position: 0 94%; background-size: 100% 100%;"
            >Holder HP Spion Motor Besi: Kunci Presisi Solid, 100% Kokoh Anti Getar!</span
          >
        </h1>

        <p class="mt-4 max-w-[400px] text-[15px] font-semibold leading-relaxed text-slate-700">
          Ojol, touring, hingga komuter harian — <span class="box-decoration-clone bg-[#FFD84D]/45 px-1 text-slate-950">material besi alloy tebal dengan sistem kunci rotary lock mekanik, pasang di lubang spion semua jenis motor tanpa ribet.</span>
        </p>
      </div>

      <!-- Hero Visual with Overlay & Ping Badge -->
      <div class="relative mt-7">
        <div
          class="relative overflow-hidden border-y border-slate-100 bg-slate-900 shadow-[0_14px_34px_rgba(30,58,138,0.12)]"
        >
          <img
            src="/images/landing/holder-hp/hero-action.webp"
            alt="Holder HP Spion Motor Besi Tangguh Terpasang Kokoh di Motor"
            class="aspect-[16/9] w-full object-cover"
            width="800"
            height="450"
            fetchpriority="high"
            loading="eager"
            decoding="async"
          />
        </div>

        <!-- Floating Glassmorphic Benefit Card -->
        <div
          class="relative z-20 mx-auto -mt-6 w-[90%] rounded-xl border border-blue-200/80 bg-white/95 p-4 text-left shadow-[0_14px_34px_rgba(30,58,138,0.14)] backdrop-blur-md"
        >
          <div class="flex gap-3">
            <span class="relative mt-1 flex h-3 w-3 shrink-0">
              <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-[#1E3A8A] opacity-70"></span>
              <span
                class="relative inline-flex h-3 w-3 rounded-full bg-[#1E3A8A] shadow-[0_0_0_6px_rgba(30,58,138,0.10)]"
              ></span>
            </span>
            <div>
              <h2 class="text-[16px] font-bold leading-tight text-[#0F2942]">Lock Putar Mekanik &amp; Anti Getar!</h2>
              <p class="mt-1 text-[13.5px] leading-relaxed text-slate-700">
                HP terkunci rapat 360°, posisi stabil dan navigasi Google Maps/Waze nyaman terbaca. <strong class="text-[#C93A1B]">Anti jatuh di jalan berlubang.</strong>
              </p>
            </div>
          </div>
        </div>

        <!-- Hero Quick Trust Strip -->
        <div class="mt-5 grid grid-cols-3 divide-x divide-slate-200 px-5 text-center">
          <div class="px-2">
            <span class="block text-[14px]">🚚</span>
            <span class="text-[11px] font-bold text-slate-800">Bisa COD</span>
            <p class="text-[10px] text-slate-500">Bayar di Tempat</p>
          </div>
          <div class="px-2">
            <span class="block text-[14px]">🛡️</span>
            <span class="text-[11px] font-bold text-slate-800">Bahan Besi Logam</span>
            <p class="text-[10px] text-slate-500">Alloy Solid Anti Patah</p>
          </div>
          <div class="px-2">
            <span class="block text-[14px]">⭐</span>
            <span class="text-[11px] font-bold text-slate-800">Rating 4.9/5</span>
            <p class="text-[10px] text-slate-500">2.400+ Terjual</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 3. VALUE PROPOSITION / HOOK ═══ -->
    <section class="px-5 py-10">
      <h2 class={sectionTitle}>
        Solusi Riding Nyaman &amp; Aman: <span class="box-decoration-clone bg-[#EFF6FF] px-1.5 pb-0.5 text-[#1E3A8A]"
          >Navigasi Bebas Cemas di Segala Medan Jalan</span
        >
      </h2>
      <p class={`${body} mt-2`}>
        Didesain khusus untuk pengendara motor Indonesia yang membutuhkan dudukan smartphone tangguh, awet, dan tidak gampang kendor.
      </p>

      <div class="mt-6 grid gap-3">
        <div class="rounded-2xl border border-blue-100 bg-[#EFF6FF] p-4">
          <div class="flex gap-3">
            <span class={listIcon}><Icon name="check" class="h-4 w-4" aria-hidden="true" /></span>
            <p class={body}>
              <strong class="text-slate-950">Material Besi Logam Kokoh &amp; Awet</strong> — Terbuat dari solid alloy tahan benturan, tidak mudah pecah atau patah seperti holder plastik murahan.
            </p>
          </div>
        </div>
        <div class="rounded-2xl border border-slate-100 bg-white p-4 shadow-sm">
          <div class="flex gap-3">
            <span class={listIcon}><Icon name="shield-check" class="h-4 w-4" aria-hidden="true" /></span>
            <p class={body}>
              <strong class="text-slate-950">Sistem Kunci Rotary Lock &amp; Grip Karet</strong> — Mengunci HP secara mekanik presisi dengan bantalan silikon lembut anti lecet, tetap kencang walau lewat polisi tidur tinggi.
            </p>
          </div>
        </div>
        <div class="rounded-2xl border border-blue-100 bg-[#EFF6FF] p-4">
          <div class="flex gap-3">
            <span class={listIcon}><Icon name="badge-check" class="h-4 w-4" aria-hidden="true" /></span>
            <p class={body}>
              <strong class="text-slate-950">Universal Semua Motor &amp; Smartphone</strong> — Dudukan spion standar (&lt; 9 mm) pas untuk Matic (Vario, Beat, Nmax, PCX, Scoopy, Aerox), Bebek &amp; Sport. Lebar jepit fleksibel 6–10 cm (HP 4.7–7 inci).
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 4. AGITATION / DANGER SIGNS ═══ -->
    <section class="border-t border-[#C93A1B]/10 bg-[#FFF7ED] px-5 py-10">
      <h2 class={sectionTitle}>
        Awas! Bahaya Fatal Pakai <span
          class="text-[#C93A1B] underline decoration-amber-300 decoration-4 underline-offset-4">Holder HP Plastik Murahan:</span>
      </h2>
      <div class="mt-6 grid gap-4">
        <div class="flex gap-3">
          <span class={dangerIcon}><Icon name="triangle-alert" class="h-4 w-4" aria-hidden="true" /></span>
          <p class={body}>
            <strong class="text-slate-950">HP Terpental &amp; Layar Pecah:</strong> Saat melewati jalan berlubang atau jalan berbatu, engsel plastik rapuh gampang patah dan HP jutaan rupiah langsung terbanting ke aspal.
          </p>
        </div>
        <div class="flex gap-3">
          <span class={dangerIcon}><Icon name="triangle-alert" class="h-4 w-4" aria-hidden="true" /></span>
          <p class={body}>
            <strong class="text-slate-950">Layar Goyang Parah &amp; Pusing:</strong> Getaran stang motor membuat peta GPS buram, sulit dibaca, dan membahayakan konsentrasi berkendara di jalan raya.
          </p>
        </div>
        <div class="flex gap-3">
          <span class={dangerIcon}><Icon name="triangle-alert" class="h-4 w-4" aria-hidden="true" /></span>
          <p class={body}>
            <strong class="text-slate-950">Holder Cepat Kendor &amp; Berputar:</strong> Dudukan plastik murahan sering kendor sendiri saat kena angin kencang atau terik matahari panas.
          </p>
        </div>
      </div>
    </section>

    <!-- ═══ 5. SCENARIOS BREAKDOWN (BUKTI PENGGUNAAN) ═══ -->
    <section class="border-t border-slate-100 px-5 py-10">
      <h2 class={sectionTitle}>
        Solusi Tepat: <span class="box-decoration-clone bg-[#EFF6FF] px-1.5 pb-0.5 text-[#1E3A8A]"
          >Layar Stabil, HP Aman, Perjalanan Lancar</span>
      </h2>
      <p class={`${body} mt-2 mb-6`}>
        Terbukti tangguh dan diandalkan ribuan pengendara motor di seluruh Indonesia:
      </p>

      <div class="grid gap-4">
        <figure class="relative overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
          <img
            src="/images/landing/holder-hp/proof-bumpy.webp"
            alt="Tetap kokoh stabil saat melewati jalan bergelombang dan rusak"
            class="aspect-[16/9] w-full object-cover"
            width="800"
            height="450"
            loading="lazy"
            decoding="async"
          />
          <figcaption
            class="absolute left-3 top-3 rounded-md bg-[#0F2942] px-3 py-1 text-[12px] font-bold uppercase tracking-wide text-white shadow-sm"
          >
            Uji Jalan Rusak &amp; Bergelombang
          </figcaption>
        </figure>

        <figure class="relative overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm">
          <img
            src="/images/landing/holder-hp/proof-ojol.webp"
            alt="Andalan harian driver ojek online dan pengendara komuter harian"
            class="aspect-[16/9] w-full object-cover"
            width="800"
            height="450"
            loading="lazy"
            decoding="async"
          />
          <figcaption
            class="absolute left-3 top-3 rounded-md bg-[#16A34A] px-3 py-1 text-[12px] font-bold uppercase tracking-wide text-white shadow-sm"
          >
            Andalan Driver Ojol &amp; Harian
          </figcaption>
        </figure>
      </div>

      <p class="mt-5 text-[14px] leading-relaxed text-slate-500">
        <strong class="text-slate-950">Praktis &amp; Efisien:</strong> Pasang dan lepas HP hanya dengan memutar knob pengunci samping dalam hitungan detik.
      </p>
    </section>

    <!-- ═══ 6. DARK CONTRAST SECTION (DETAIL KUNCI & CARA PASANG) ═══ -->
    <section class="border-t border-slate-900 bg-[#0B1E36] px-5 py-10 text-white">
      <h2 class="text-[26px] font-bold leading-[1.14] tracking-tight text-white">
        Presisi Logam Solid: <span class="text-[#93C5FD]">Mekanisme Rotary Lock Anti Goyang</span>
      </h2>
      <p class="mt-2 mb-6 text-[15px] leading-relaxed text-slate-300">
        Setiap komponen dirancang presisi dengan bahan alloy tebal dan bantalan karet peredam kejut:
      </p>

      <div class="-mx-5 mb-8">
        <div class="relative overflow-hidden bg-slate-900">
          <img
            src="/images/landing/holder-hp/proof-clamp.webp"
            alt="Detail mekanisme pengunci rotary lock dan bantalan peredam silikon"
            class="aspect-[16/9] w-full object-cover"
            width="800"
            height="450"
            loading="lazy"
            decoding="async"
          />
          <div
            class="absolute left-4 top-4 rounded bg-amber-500 px-2.5 py-1 text-[11px] font-bold uppercase tracking-wider text-slate-950 shadow"
          >
            Bahan Besi Solid &amp; Kunci Rotary Lock
          </div>
        </div>
      </div>

      <div class="border-t border-slate-700/60 pt-7">
        <h3 class="text-[19px] font-bold text-white mb-4">3 Langkah Pemasangan Super Mudah:</h3>
        <div class="grid gap-4">
          <div class="flex gap-3">
            <span
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[#93C5FD] text-[14px] font-bold text-slate-950"
              >1</span
            >
            <p class="text-[15px] leading-relaxed text-slate-300">
              <strong class="text-white">Lepas Baut Spion:</strong> Buka baut spion motor Anda menggunakan kunci pas standar.
            </p>
          </div>
          <div class="flex gap-3">
            <span
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[#93C5FD] text-[14px] font-bold text-slate-950"
              >2</span
            >
            <p class="text-[15px] leading-relaxed text-slate-300">
              <strong class="text-white">Pasang Dudukan Holder:</strong> Masukkan plat lubang dudukan holder ke ulir baut spion lalu kencangkan kembali spion motor Anda.
            </p>
          </div>
          <div class="flex gap-3">
            <span
              class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-[#93C5FD] text-[14px] font-bold text-slate-950"
              >3</span
            >
            <p class="text-[15px] leading-relaxed text-slate-300">
              <strong class="text-white">Kunci HP Anda:</strong> Taruh smartphone di dudukan dan putar knob pengunci samping hingga mencengkeram kuat.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ 7. INFOGRAPHIC FITUR DETAIL PRODUK ═══ -->
    <section class="border-t border-slate-100 bg-[#F8FAFC] px-4 py-8 space-y-5">
      <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-white">
        <img
          src="/images/landing/holder-hp/banner-holder-tangguh.webp"
          alt="Holder HP Tangguh - Kokoh Anti Getar, Aman Tetap Stabil, Pas di Semua Motor, Posisi Tetap Tidak Putar"
          class="w-full h-auto block"
          width="800"
          height="1067"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-white">
        <img
          src="/images/landing/holder-hp/banner-spion-besi.webp"
          alt="Holder Spion Motor Besi HM-20 - Kokoh & Stabil, Lebar Fleksibel 6-10cm, Cocok Untuk Lubang Spion < 9mm"
          class="w-full h-auto block"
          width="800"
          height="1067"
          loading="lazy"
          decoding="async"
        />
      </div>
    </section>

    <!-- ═══ 8. TESTIMONIALS (EDITORIAL OPEN PROOF PATTERN) ═══ -->
    <section class="border-t border-slate-100 px-5 py-10">
      <div class="mb-8">
        <span class="inline-block rounded-md bg-[#EFF6FF] px-2.5 py-1 text-[11px] font-bold uppercase tracking-widest text-[#1E3A8A] ring-1 ring-[#1E3A8A]/15 mb-2">
          Pengalaman Nyata Pelanggan
        </span>
        <h2 class={sectionTitle}>
          Bukti Nyata Pengguna: <span class="box-decoration-clone bg-[#EFF6FF] px-1.5 pb-0.5 text-[#1E3A8A]"
            >HP Terkunci Mantap &amp; Bebas Khawatir di Jalan</span
          >
        </h2>
        <p class={`${body} mt-2`}>
          Cerita jujur dari para rider yang sudah membuktikan kekokohan Holder HP Besi ini:
        </p>
      </div>

      <div class="space-y-9">
        {
          [
            {
              name: 'Bang Ridwan Santoso',
              location: 'Jakarta Barat, DKI Jakarta',
              avatar: '/images/landing/holder-hp/avatar-1.webp',
              problem: 'Driver Ojol • Masalah: Holder Plastik Sering Patah Kena Polisi Tidur',
              image: '/images/landing/holder-hp/proof-ojol.webp',
              imageCaption: 'Hasil nyata: HP tetap stabil dan aman dipakai narik ojol 12 jam sehari',
              review:
                'Sudah habis 3 holder plastik gara-gara patah pas hajar jalan rusak di Jakarta. Pas ganti ke holder besi ini <strong class="box-decoration-clone bg-[#EFF6FF] px-1.5 pb-0.5 text-[#1E3A8A] font-semibold">beneran kokoh anti getar, kunci rotary lock-nya mantap banget</strong>. Sekarang narik ojol seharian lihat Google Maps jadi tenang dan gak takut HP mental!',
              takeaway: 'Material besi solid sangat awet, HP terkunci stabil untuk penggunaan harian intensif.',
            },
            {
              name: 'Mas Bayu Anggara',
              location: 'Surabaya, Jawa Timur',
              avatar: '/images/landing/holder-hp/avatar-2.webp',
              problem: 'Komuter Motor Matic • Masalah: Layar Goyang Bikin Pusing Saat Riding',
              image: '/images/landing/holder-hp/proof-bumpy.webp',
              imageCaption: 'Hasil nyata: Peta navigasi sangat jelas terbaca walau motor melaju kencang',
              review:
                'Pasang di spion Vario 160 sangat presisi dan pas. <strong class="box-decoration-clone bg-[#EFF6FF] px-1.5 pb-0.5 text-[#1E3A8A] font-semibold">Karet bantalannya tebal jadi bodi HP gak lecet sama sekali</strong>. Dipakai kecepatan 70 km/jam tetap tegak lurus dan gak muter-muter kena angin. Recommended buat yang cari holder berkualitas.',
              takeaway: 'Presisi di motor matic, bodi HP terlindungi karet lembut tanpa lecet.',
            },
            {
              name: 'Mas Hendra Wijaya',
              location: 'Semarang, Jawa Tengah',
              avatar: '/images/landing/holder-hp/avatar-3.webp',
              problem: 'Touring & Harian • Masalah: Takut HP Copot / Dijambret di Lampu Merah',
              image: '/images/landing/holder-hp/proof-clamp.webp',
              imageCaption: 'Hasil nyata: Sistem rotary lock mengunci rapat dan sangat aman',
              review:
                'Kualitas besinya tebal bukan kaleng-kaleng. <strong class="box-decoration-clone bg-[#EFF6FF] px-1.5 pb-0.5 text-[#1E3A8A] font-semibold">Cengkeramannya kuat banget jadi gak gampang dirampas orang saat berhenti di lampu merah</strong>. Pengiriman cepat, barang sesuai foto dan bisa bayar COD pas sampai rumah.',
              takeaway: 'Kunci rotary lock sangat kencang dan memberi rasa aman maksimal saat berkendara.',
            },
          ].map((item, index, arr) => (
            <div class="space-y-3.5">
              <!-- Customer Header -->
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-center gap-3">
                  <img
                    src={item.avatar}
                    alt={`Foto ${item.name}`}
                    class="h-12 w-12 rounded-full object-cover ring-2 ring-slate-100 shrink-0"
                    width="48"
                    height="48"
                    loading="lazy"
                    decoding="async"
                  />
                  <div>
                    <div class="flex items-center gap-1.5">
                      <h3 class="text-[16px] font-bold text-slate-950">{item.name}</h3>
                      <span class="flex h-4 w-4 items-center justify-center text-blue-600">
                        <Icon name="badge-check" class="h-4 w-4" aria-hidden="true" />
                      </span>
                    </div>
                    <p class="text-[12px] font-medium text-slate-500">{item.location}</p>
                  </div>
                </div>
                <div class="shrink-0 text-[13px] text-[#FBBF24]" role="img" aria-label="5 dari 5 bintang">
                  ★★★★★
                </div>
              </div>

              <!-- Problem Pill -->
              <div class="inline-block rounded-md px-2.5 py-1 text-[11px] font-semibold tracking-wide border border-slate-200/70 bg-slate-50 text-slate-700">
                {item.problem}
              </div>

              <!-- Proof Photo with Aspect 16/9 -->
              <div class="relative aspect-[16/9] w-full overflow-hidden rounded-xl border border-slate-200/80 shadow-sm">
                <img
                  src={item.image}
                  alt={item.imageCaption}
                  class="h-full w-full object-cover"
                  width="800"
                  height="450"
                  loading="lazy"
                  decoding="async"
                />
              </div>

              <!-- Quote with Highlighted Spans and Left Border Accent -->
              <p
                class="border-l-2 border-[#1E3A8A]/35 pl-3.5 text-[15px] leading-relaxed text-slate-700 italic pt-0.5"
                set:html={`“${item.review}”`}
              />

              <!-- Key Takeaway Box -->
              <div class="flex items-center gap-2 rounded-lg bg-[#EFF6FF] px-3 py-2 text-[12px] font-semibold text-[#1E3A8A]">
                <span>📌</span>
                <span>{item.takeaway}</span>
              </div>

              {index < arr.length - 1 && (
                <div class="pt-6">
                  <div class="h-px bg-gradient-to-r from-transparent via-slate-200 to-transparent" />
                </div>
              )}
            </div>
          ))
        }
      </div>
    </section>

