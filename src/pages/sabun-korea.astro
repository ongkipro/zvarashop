---
/*
 * Native Astro landing page — Sabun Korea Glowing Pemutih Badan & Wajah 140g.
 * Clean, Direct-Response Indonesian Commerce Funnel.
 * Studio AI generated visuals, BPOM NA18200500036, zero emojis in copy.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import { getStorefrontProduct, getStorefrontProducts } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';
import '../styles/landing-pages/sabun-korea.css';

export const prerender = false;

const SLUG = 'sabun-korea';
const PRODUCT_SLUG = 'sabun-korea';

const formContext = await resolveFormModeContext(Astro.request);

// Product resolution with strict DB fallback
let product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) {
  product = await getStorefrontProduct(Astro.locals, '98822');
}
if (!product) {
  const allProducts = await getStorefrontProducts(Astro.locals);
  product = allProducts.find((p) => p.slug.includes('sabun') || p.slug.includes('korea')) ?? allProducts[0] ?? null;
}
if (!product) return Astro.rewrite('/404');

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const seoTitle = 'Sabun Korea Glowing Pemutih Badan & Wajah 140g BPOM — Kulit Cerah & Lembap';
const seoDescription =
  'Sabun pencerah badan dan wajah alami khas Korea BPOM NA18200500036. Efektif rontokkan daki menumpuk, cerahkan kulit kusam & lipatan gelap. Bisa COD.';

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;
const comparePrice = cheapest?.comparePrice ?? Math.round(price * 1.75);
const socialProofOrders = await recentOrderCount(getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined);
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image="/images/landing/sabun-korea/hero-product.webp"
  preloadImages="/images/landing/sabun-korea/hero-product.webp"
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <main class="mx-auto min-h-screen w-full max-w-[480px] overflow-x-hidden bg-white pb-8 font-sans text-slate-900 shadow-xl antialiased selection:bg-[#0A2540] selection:text-white">
    <MetaLandingTracker
      slug={SLUG}
      contentId={defaultCatalogContentId(product)}
      contentName={product.contentName}
      price={price}
    />

    <!-- ═══ 1. TOP ANNOUNCEMENT BAR ═══ -->
    <header class="flex items-center justify-between border-b border-slate-800 bg-[#0A2540] px-3.5 py-2 text-white shadow-xs">
      <div class="flex items-center gap-1.5 text-[11.5px] sm:text-[12px] font-bold tracking-wide">
        <span class="relative flex h-2 w-2 shrink-0">
          <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex h-2 w-2 rounded-full bg-red-500"></span>
        </span>
        <span class="text-amber-300 uppercase">Promo Khusus:</span>
        <span class="text-white font-bold">Mulai Rp{Math.round(price).toLocaleString('id-ID')}</span>
