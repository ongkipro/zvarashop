          </div>
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-sky-600 shrink-0"></span>
            <p class="text-[12.5px] sm:text-[13px] font-bold text-slate-900">
              Aman untuk Keramik, Porselen, Kaca, dan Keran Chrome Stainless
            </p>
          </div>
        </div>
      </div>

      <!-- Quick Scroll Anchor CTA Button -->
      <div class="mt-5 px-4 sm:px-5">
        <a
          href="#form-pemesanan"
          class="flex items-center justify-center gap-2 w-full py-3.5 px-6 rounded-xl font-extrabold text-[15px] sm:text-[16px] text-white bg-gradient-to-r from-sky-600 to-blue-700 hover:from-sky-700 hover:to-blue-800 shadow-md shadow-sky-600/25 active:scale-[0.98] transition-all tracking-wide"
