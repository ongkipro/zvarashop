---
/*
 * Native Astro landing page — GlowHome Foam Pembersih Toilet 500ml.
 * High-Converting Direct-Response Indonesian Commerce Funnel.
 * Active micro-foam bathroom & toilet stain dissolver.
 * Zero emojis, zero emoticons, zero AI slop, WCAG AA contrast compliant.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import { getStorefrontProduct, getStorefrontProducts } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';
import '../styles/landing-pages/foam-toilet.css';

export const prerender = false;

const SLUG = 'foam-pembersih-toilet-500ml';
const PRODUCT_SLUG = 'foam-pembersih-toilet-500ml';

const formContext = await resolveFormModeContext(Astro.request);

// Product resolution with strict DB fallback
let product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) {
  product = await getStorefrontProduct(Astro.locals, '18399');
}
if (!product) {
  const allProducts = await getStorefrontProducts(Astro.locals);
  product = allProducts.find((p) => p.slug.includes('foam') || p.slug.includes('toilet')) ?? allProducts[0] ?? null;
}
if (!product) return Astro.rewrite('/404');

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const seoTitle = `${product.productName} — Busa Aktif Rontokkan Kerak Toilet Seketika`;
const seoDescription =
  product.description ||
  'GlowHome Foam Pembersih Toilet 500ml busa aktif pembersih kerak, jamur, noda air membandel pada kloset, wastafel, dan keramik. Bersih mengkilap tanpa sikat keras, 99.99% basmi kuman, aroma harum segar, bisa COD se-Indonesia.';

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price ?? 79000;
const bundleVariant = product.variants.find((v) => v.sku === 'PG04' || v.label.includes('2') || v.id === '20068') ?? product.variants[1] ?? null;
const bundlePrice = bundleVariant?.price ?? 148500;
const bundleCompare = bundleVariant?.comparePrice ?? 176000;
const bundleSavings = (bundleCompare && bundlePrice) ? bundleCompare - bundlePrice : 27500;
const productImage = product.image || '/images/landing/foam-toilet/hero-product.webp';
const socialProofOrders = await recentOrderCount(getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined);
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image={productImage}
  preloadImages="/images/landing/foam-toilet/hero-product.webp"
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-12 font-sans text-slate-900 shadow-2xl selection:bg-[#0284C7] selection:text-white antialiased">
    <MetaLandingTracker
      slug={SLUG}
      contentId={defaultCatalogContentId(product)}
      contentName={product.contentName}
      price={price}
    />

    <!-- ═══ 1. URGENCY ANNOUNCEMENT BAR (TOP) ═══ -->
    <header class="flex items-center justify-between border-b border-sky-950 bg-[#061826] px-3 py-2 text-white shadow-xs">
      <div class="flex items-center gap-1.5 text-[10.5px] min-[380px]:text-[11.5px] font-extrabold tracking-wide min-w-0">
        <span class="flex h-2 w-2 relative shrink-0">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan-500"></span>
        </span>
        <span class="text-amber-300 font-black uppercase shrink-0">PROMO:</span>
        <span class="text-slate-100 font-bold whitespace-nowrap">BELI 2 HEMAT RP{Math.round(bundleSavings).toLocaleString('id-ID')}</span>
      </div>
      <span class="whitespace-nowrap text-[9.5px] min-[380px]:text-[10.5px] font-black tracking-wider text-amber-300 bg-sky-950/90 px-2 py-0.5 rounded-full border border-sky-700/60 shadow-xs shrink-0 ml-1.5">
        BISA COD
      </span>
    </header>

    <!-- ═══ 2. HERO SECTION (HEADLINE, SOMATIC HOOK & HERO PACKSHOT) ═══ -->
    <section id="landing-hero" class="bg-white text-center pb-8">
      <div class="px-4 sm:px-5 pt-5 sm:pt-6">
        <!-- Social Proof Text Badge -->
        <div class="mb-3 inline-flex items-center justify-center gap-1.5 text-[11.5px] sm:text-[12px] font-bold text-slate-800 bg-sky-50/90 px-3.5 py-1 rounded-full border border-sky-200/80 shadow-2xs">
          <span class="text-sky-800 font-extrabold uppercase tracking-wide">Rating 4.9 / 5.0</span>
          <span class="text-slate-400">•</span>
          <span class="text-slate-600 font-medium">4.190+ Rumah Tangga Puas</span>
        </div>

        <!-- Main Impact Headline -->
        <h1 class="mx-auto max-w-[440px] text-[clamp(21px,6.8vw,26px)] font-black leading-[1.25] tracking-tight text-slate-950">
          Kloset Kuning &amp; Kerak Menahun Susah Hilang? Semprot Busa Aktif, <span class="box-decoration-clone rounded-[0.18em] bg-sky-100 text-sky-950 px-1.5 py-0.5">Kerak Rontok Sendiri</span> Tanpa Capek Sikat Keras!
        </h1>

        <!-- Somatic Problem Subheadline -->
        <p class="mt-3 text-[13.5px] sm:text-[14.5px] leading-relaxed text-slate-600 font-normal max-w-[420px] mx-auto text-center">
          Formula busa tebal Micro-Penetration Surfaktan K12+APG dan Asam Amino Sulfonat mengunci dan melarutkan kerak kapur, noda urin membandel, serta jamur hitam dalam 3 menit. Kloset dan wastafel kembali putih mengkilap seperti baru dipasang.
        </p>
      </div>

      <!-- HERO IMAGE PACKSHOT -->
      <div class="mt-5 relative w-full overflow-hidden bg-slate-950 shadow-md border-y border-slate-200">
        <img
          src="/images/landing/foam-toilet/hero-product.webp"
          alt="GlowHöme Foam Pembersih Toilet 500ml busa lembut tanpa perlu disikat"
          class="w-full h-auto aspect-[4/3] object-cover block"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          width="1024"
          height="768"
        />
        <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-950/95 via-slate-950/70 to-transparent px-3 pt-6 pb-2 text-center">
          <p class="text-[11.5px] sm:text-[12px] font-bold text-cyan-300">
            Netto 500ml • Busa Lembut Tanpa Perlu Disikat • Harum Jasmine 24 Jam
          </p>
        </div>
      </div>

      <!-- Callout Benefit Grid -->
      <div class="mt-4 px-4 sm:px-5">
        <div class="p-3.5 rounded-2xl bg-sky-50/70 border border-sky-100 text-left space-y-2">
          <div class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-sky-600 shrink-0"></span>
            <p class="text-[12.5px] sm:text-[13px] font-bold text-slate-900">
              Busa Aktif Menempel di Dinding Miring — Tidak Langsung Hanyut
