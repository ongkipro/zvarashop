    <!-- ═══ 7. STICKY MOBILE PURCHASE BAR ═══ -->
    <div
      id="sticky-purchase-bar"
      class="fixed inset-x-0 bottom-0 z-40 mx-auto flex w-full max-w-[480px] items-center justify-between border-t border-stone-200 bg-white/95 px-4 py-3 backdrop-blur-md transition-all duration-300 lg:hidden"
      style="transform: translateY(100%); opacity: 0; pointer-events: none"
    >
      <div>
        <p class="text-[10px] font-semibold uppercase tracking-wider text-slate-500">
          Buy 1 Get 2
        </p>
        <div class="flex items-baseline gap-1.5">
          <p class="text-base font-bold text-slate-950">Rp{rupiah(price)}</p>
          <span class="text-[11px] text-slate-400 line-through">Rp{rupiah(comparePrice)}</span>
        </div>
      </div>
      <a
        href="#form-pemesanan"
        class="inline-flex min-h-11 items-center justify-center rounded-lg bg-stone-950 px-5 text-[11px] font-bold uppercase tracking-wider text-amber-300 transition-colors hover:bg-stone-800"
      >
        Pesan Sekarang (COD)
      </a>
    </div>
  </main>

  <script is:inline>
    function initStickyBarObserver() {
      const stickyBar = document.getElementById('sticky-purchase-bar');
      const orderForm = document.getElementById('form-pemesanan');
      const hero = document.getElementById('landing-hero');
      if (!stickyBar || !orderForm) return;

      let heroVisible = true;
      let formVisible = false;

      const applyStickyVisibility = () => {
        if (heroVisible || formVisible) {
          stickyBar.style.transform = 'translateY(100%)';
          stickyBar.style.opacity = '0';
          stickyBar.style.pointerEvents = 'none';
        } else {
          stickyBar.style.transform = 'translateY(0)';
          stickyBar.style.opacity = '1';
          stickyBar.style.pointerEvents = 'auto';
        }
      };

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.target === hero) heroVisible = entry.isIntersecting;
            if (entry.target === orderForm) formVisible = entry.isIntersecting;
          });
          applyStickyVisibility();
        },
        { threshold: 0, rootMargin: '0px 0px -40px 0px' }
      );

      if (hero) observer.observe(hero);
      else heroVisible = false;
      observer.observe(orderForm);
      applyStickyVisibility();

      document.querySelectorAll('[data-select-variant]').forEach((card) => {
        card.addEventListener('click', () => {
          const variantId = card.getAttribute('data-select-variant');
          if (!variantId) return;
          const radio = document.querySelector(
            `input[name="variant"][value="${CSS.escape(variantId)}"]`
          );
          if (radio instanceof HTMLInputElement && !radio.checked) {
            radio.checked = true;
            radio.dispatchEvent(new Event('change', { bubbles: true }));
          }
        });
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initStickyBarObserver);
    } else {
      initStickyBarObserver();
    }
  </script>
</BaseLayout>
