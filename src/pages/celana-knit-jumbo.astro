  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-16 font-sans text-slate-950 selection:bg-amber-200 selection:text-slate-950 antialiased">
    <MetaLandingTracker
      slug={SLUG}
      contentId={defaultCatalogContentId(product)}
      contentName={product.contentName}
      price={price}
    />

    <!-- ═══ 1. TOP BAR ═══ -->
    <header class="flex items-center justify-between border-b border-stone-800 bg-stone-950 px-4 py-2 text-white">
      <div class="flex items-center gap-1.5 text-[11px] font-bold tracking-wide min-w-0">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="1em"
          height="1em"
