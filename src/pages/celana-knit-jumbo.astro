---
/*
 * Native Astro landing page — Celana Knit Jumbo (Celana Panjang Knit Rib).
 * Product ID: 39270 | Variants: 20183 (BUY 1 GET 2) & 20184 (BUY 2 GET 4).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import { getStorefrontProduct } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';
import '../styles/landing-pages/celana-knit-jumbo.css';

export const prerender = false;

const SLUG = 'celana-knit-jumbo';
const PRODUCT_SLUG = 'celana-knit-jumbo';

let product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) {
  product = await getStorefrontProduct(Astro.locals, '39270');
}
if (!product) return Astro.rewrite('/404');

const formContext = await resolveFormModeContext(Astro.request);
const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const seoTitle = 'Celana Knit Jumbo Kulot Rib Adem Melar BB 55-85 Kg - Zvara Shop';
const seoDescription =
  'Celana Knit Jumbo model kulot longgar berbahan knit rib lembut, adem, dan melar dengan pinggang full karet elastis untuk ukuran BB 55 hingga 85 kg.';

const sortedVariants = [...product.variants].sort((a, b) => a.price - b.price);
const cheapest = sortedVariants[0] ?? null;
const bundleVariant =
  product.variants.find((v) => v.id === '20184' || v.label.toUpperCase().includes('BUY 2')) ??
  sortedVariants[1] ??
  cheapest;

const price = cheapest?.price ?? product.price ?? 99000;
const comparePrice = cheapest?.comparePrice ?? 130000;

const bundlePrice = bundleVariant?.price ?? 195000;
const bundleCompare = bundleVariant?.comparePrice ?? 260000;

const rupiah = (value: number) => Math.round(value).toLocaleString('id-ID');
const socialProofOrders = await recentOrderCount(getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined);
