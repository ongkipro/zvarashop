          </a>

          <!-- Paket 2: BUY 2 GET 4 -->
          <a
            href="#form-pemesanan"
            data-select-variant={bundleVariant?.id ?? '20184'}
            class="flex items-center justify-between border-2 border-amber-400 bg-stone-900 px-4 py-3.5 rounded-lg transition-colors hover:bg-stone-900/80"
          >
            <div>
              <span class="inline-block text-[10px] font-bold uppercase tracking-wider text-slate-950 bg-amber-400 px-1.5 py-0.5 rounded mb-1">
