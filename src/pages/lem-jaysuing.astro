---
/*
 * Native Astro landing page — Lem Anti Bocor Jaysuing 300gr.
 * Clean, High-Converting Direct-Response Funnel
 * Exact Visual & Structural Reference: https://zvara.shop/nature-gemuk-badan
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import MetaLandingTracker from '../components/storefront/tracking/MetaLandingTracker.astro';
import GeoIpResolvedForm from '../components/storefront/forms/GeoIpResolvedForm.astro';
import SocialProofToast from '../components/storefront/shared/SocialProofToast.astro';
import { recentOrderCount } from '../lib/social-proof';
import { getRuntimeEnv } from '../lib/env';
import { getStorefrontProduct, getStorefrontProducts } from '../lib/catalog';
import { nativeLandingCanonicalPath } from '../lib/landing-pages';
import { defaultCatalogContentId } from '../lib/catalog-feed';
import { resolveFormModeContext } from '../lib/form-mode';
import '../styles/form-hybrid.css';
import '../styles/landing-pages/landing.css';
import '../styles/landing-pages/lem-jaysuing.css';

export const prerender = false;

const SLUG = 'lem-jaysuing';
const PRODUCT_SLUG = 'lem-anti-bocor-jaysuing-300gr';

// Product resolution with strict DB fallback
let product = await getStorefrontProduct(Astro.locals, PRODUCT_SLUG);
if (!product) {
  const allProducts = await getStorefrontProducts(Astro.locals);
  product = allProducts.find((p) => p.slug.includes('jaysuing') || p.slug.includes('bocor')) ?? allProducts[0] ?? null;
}
if (!product) return Astro.rewrite('/404');

const formContext = await resolveFormModeContext(Astro.request);

const canonical = `${Astro.locals.tenant.siteUrl}${await nativeLandingCanonicalPath(Astro.locals, SLUG)}`;
const seoTitle = 'Lem Anti Bocor Jaysuing 300gr Waterproof Transparan — Solusi Tambal Cepat Anti Rembes';
const seoDescription =
  'Lem pelapis anti bocor waterproof Jaysuing 300g bonus kuas aplikasi. Cepat kering, 100% bening transparan, tahan panas dan hujan untuk atap, nat keramik, pipa, dan dinding. Bisa COD!';

const cheapest = [...product.variants].sort((a, b) => a.price - b.price)[0] ?? null;
const price = cheapest?.price ?? product.price;
const comparePrice = cheapest?.comparePrice ?? Math.round(price * 1.14);
const socialProofOrders = await recentOrderCount(getRuntimeEnv(Astro.locals)?.OMS_DB as D1Database | undefined);
---

<BaseLayout
  title={seoTitle}
  description={seoDescription}
  image="/images/landing/lem-jaysuing/hero-lifestyle.webp"
  preloadImages="/images/landing/lem-jaysuing/hero-lifestyle.webp"
  canonical={canonical}
  hideHeader={true}
  hideFooter={true}
>
  <main class="mx-auto min-h-screen w-full max-w-[480px] bg-white pb-12 font-sans text-slate-900 shadow-2xl selection:bg-[#0F766E] selection:text-white antialiased">
    <MetaLandingTracker
      slug={SLUG}
      contentId={defaultCatalogContentId(product)}
      contentName={product.contentName}
      price={price}
    />

    <!-- ═══ 1. URGENCY ANNOUNCEMENT BAR (TOP) ═══ -->
    <header class="flex items-center justify-between border-b border-cyan-950 bg-[#083344] px-4 py-2.5 text-white shadow-sm">
      <div class="flex items-center gap-2 text-[12px] font-bold tracking-wide">
        <span class="flex h-2 w-2 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-red-500"></span>
        </span>
        <span class="text-amber-300">PROMO HARI INI:</span>
        <span class="text-white">MULAI Rp{Math.round(price).toLocaleString('id-ID')}</span>
