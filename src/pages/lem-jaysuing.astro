            </span>
            <span class="text-[32px] sm:text-[35px] font-extrabold text-amber-300 font-mono tracking-tight leading-none">
              Rp{Math.round(price).toLocaleString('id-ID')}
            </span>
          </div>
          <div class="pt-1">
            <span class="inline-flex items-center bg-white/10 text-amber-200 border border-amber-400/30 text-[12px] font-semibold px-3 py-1 rounded-md">
              Beli 2 Lebih Hemat (Hanya Rp109.000) + FREE KUAS + BISA COD
            </span>
          </div>
        </div>

        <!-- Stock Progress Bar -->
        <div class="space-y-1 pt-1">
          <div class="flex items-center justify-between text-[11.5px] font-medium">
            <span class="text-slate-300">Sisa Kuota Promo Hari Ini:</span>
            <span id="stock-count-text" class="text-amber-300 font-bold">Tersisa 14 Toples Lagi</span>
          </div>
          <div class="w-full bg-white/20 h-2 rounded-full overflow-hidden">
            <div id="stock-progress-bar" class="bg-gradient-to-r from-amber-400 to-red-500 h-full rounded-full transition-all duration-500" style="width: 65%;"></div>
