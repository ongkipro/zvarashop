---
import SiteBrand from './SiteBrand.astro';

const footerLegal = [
  { label: 'Produk', href: '/produk' },
  { label: 'Tentang Kami', href: '/tentang' },
  { label: 'Kebijakan Privasi', href: '/kebijakan-privasi' },
  { label: 'Syarat & Ketentuan', href: '/syarat-ketentuan' },
  { label: 'Pengiriman & Retur', href: '/pengiriman' },
  { label: 'Kontak', href: '/kontak' },
  { label: 'Disclaimer', href: '/disclaimer' },
];
---

<footer class="border-t border-[#E5E5E5] bg-[#FFFFFF] px-5 py-12 text-[#222222]">
  <div class="mx-auto max-w-[480px] space-y-10 text-center">
    <!-- Brand Logo -->
    <div class="flex justify-center">
      <SiteBrand href="/" tone="dark" />
    </div>



    <!-- Policy Links -->
    <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-4 border-t border-[#E5E5E5] pt-8 text-[10px] font-semibold tracking-widest uppercase text-[#222222]">
      {
        footerLegal.map((item) => (
          <a href={item.href} class="transition-colors hover:text-[#EE4D2D] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#EE4D2D]">
            {item.label}
          </a>
        ))
      }
    </div>

    <!-- Copyright -->
    <p class="text-[10px] uppercase tracking-wider text-[#757575]">
      © {new Date().getFullYear()} {Astro.locals.tenant.name}. All Rights Reserved.
    </p>
  </div>
</footer>
