---
interface Props {
  href?: string;
  class?: string;
  tone?: 'light' | 'dark' | 'glossy';
  showTagline?: boolean;
}

const { href = '/', class: className = '', tone = 'dark', showTagline = false } = Astro.props;
const isLight = tone === 'light';
const textClass = isLight ? 'text-white' : 'text-[#222222]';
const primaryClass = 'text-[#EE4D2D]';

const storeName = Astro.locals.tenant.name.trim();
const [leadWord = '', ...restWords] = storeName.split(/\s+/);
const trailingWords = restWords.join(' ');
const tagline = Astro.locals.tenant.tagline?.trim() ?? '';
const monogram = (leadWord[0] ?? 'A').toUpperCase();
---

<a
  href={href}
  class={`group inline-flex min-h-11 items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#EE4D2D] rounded-md ${className}`}
  aria-label={Astro.locals.tenant.name}
  title={`${Astro.locals.tenant.name} - ${Astro.locals.tenant.tagline}`}
>
  <span class="flex flex-col justify-center">
    <span
      class={`whitespace-nowrap text-xl font-black uppercase tracking-tighter leading-none ${textClass}`}
    >
      {leadWord}{trailingWords && <span class={`ml-1 font-extrabold ${primaryClass}`}>{trailingWords}</span>}
    </span>
    {
      showTagline && tagline && (
        <span
          class="mt-1 text-[9px] font-bold uppercase tracking-widest text-[#757575]"
        >
          {tagline}
        </span>
      )
    }
  </span>
</a>
