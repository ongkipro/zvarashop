---
import { cardImageSrc } from '../../lib/image-derivative';

interface ProductVariant {
  id: string;
  label: string;
  price: number;
  comparePrice?: number;
}

interface Props {
  product: {
    slug: string;
    productName: string;
    heroImage: string;
    tag?: string;
    category: string;
    price: number;
    comparePrice?: number;
    variants: ProductVariant[];
  };
  formatPrice: (value: number) => string;
}

const { product, formatPrice } = Astro.props;
const comparePrice = product.comparePrice ?? 0;
const hasDiscount = comparePrice > product.price;
const discountPercentage = hasDiscount
  ? Math.round((1 - product.price / comparePrice) * 100)
  : 0;
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-slate-100 transition-all hover:shadow-md">
  <a
    href={`/produk/${product.slug}`}
    class="flex h-full flex-col focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#EE4D2D]"
  >
    <div class="relative aspect-square w-full overflow-hidden bg-slate-50">
      <img
        src={cardImageSrc(product.heroImage)}
        alt={`Foto produk ${product.productName}`}
        width="320"
        height="320"
        class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
      {discountPercentage > 0 && (
        <div class="absolute right-0 top-0 flex flex-col items-center bg-[#FEEA2E]/90 px-1.5 py-1 backdrop-blur-xs rounded-bl-md z-10">
          <span class="text-[10px] font-black leading-none text-[#EE4D2D]">{discountPercentage}%</span>
          <span class="mt-0.5 rounded-sm bg-[#EE4D2D] px-1 py-[2px] text-[8px] font-bold leading-none text-white uppercase tracking-wider">OFF</span>
        </div>
      )}
    </div>

    <div class="flex flex-1 flex-col p-3">
      <h2 class="line-clamp-2 min-h-10 text-[13px] font-medium leading-5 text-slate-800">
        {product.productName}
      </h2>

      <div class="mt-auto pt-3">
        {hasDiscount && (
          <div class="flex items-center gap-1.5 mb-0.5">
            <span class="rounded bg-[#EE4D2D]/10 px-1 py-0.5 text-[9px] font-semibold text-[#EE4D2D]">HEMAT</span>
            <span class="text-[11px] text-slate-400 line-through">
              {formatPrice(comparePrice)}
            </span>
          </div>
        )}
        <p class="text-base font-bold text-[#EE4D2D]">{formatPrice(product.price)}</p>
      </div>

      <div class="mt-3 flex items-center justify-between text-[11px] text-slate-500">
        <span class="truncate">{product.category}</span>
        <span class="shrink-0">{product.variants.length} Varian</span>
      </div>
    </div>
  </a>
</article>
