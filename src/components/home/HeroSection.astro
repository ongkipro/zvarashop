---

interface Slide {
  image: string;
  alt: string;
  badge: string;
  text: string;
}

interface Highlight {
  label: string;
  icon: string;
}
interface HeroContent {
  title: string;
  description: string;
  ratingLabel: string;
}

interface Props {
  slides: Slide[];
  highlights: Highlight[];
  content: HeroContent;
}

const { slides } = Astro.props;
---

<section class="bg-white">
  <h1 class="sr-only">{Astro.locals.tenant.name} — {Astro.locals.tenant.tagline}</h1>
  <div class="relative overflow-hidden bg-slate-100">
    <div id="hero-track" class="flex transition-transform duration-700 ease-out will-change-transform">
      {
        slides.map((slide, index) => (
          <article class="relative min-w-full">
            <img
              src={slide.image}
              alt={`${slide.alt} - ${Astro.locals.tenant.name}`}
              title={slide.badge}
              width="600"
              height="750"
              class="aspect-[4/5] w-full object-cover object-center"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding={index === 0 ? 'sync' : 'async'}
              fetchpriority={index === 0 ? 'high' : undefined}
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900/90 via-slate-900/30 to-transparent pointer-events-none" />
            <div class="absolute inset-x-0 bottom-0 p-5 pb-14 text-white">
              <span class="inline-flex rounded bg-[#EE4D2D] px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white shadow-sm">
                {slide.badge}
              </span>
              <p class="mt-3 max-w-[24rem] text-[15px] font-medium leading-relaxed text-slate-50 drop-shadow-sm">
                {slide.text}
              </p>
            </div>
          </article>
        ))
      }
    </div>
    <div id="hero-dots" class="absolute bottom-4 left-5 z-10 flex items-end gap-1.5">
      {
        slides.map((_, index) => (
          <button
            type="button"
            aria-label={`Tampilkan slide ${index + 1}`}
            class={index === 0
              ? 'h-11 w-7 border-b-2 border-white bg-transparent transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white'
              : 'h-11 w-4 border-b border-white/55 bg-transparent transition-colors hover:border-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white'}
          />
        ))
      }
    </div>
  </div>
</section>
