---
import Icon from '../shared/Icon.astro';

interface Product {
  name: string;
  category: string;
  description: string;
  href: string;
  image: string;
  price: number;
  comparePrice?: number;
  ratingValue?: number;
  reviewCount?: number;
  soldCount?: number;
  variants?: Array<{ label: string; price: number }>;
}

interface Heading {
  eyebrow: string;
  title: string;
  description: string;
}

interface Props {
  products: Product[];
  heading: Heading;
}

const { products, heading } = Astro.props;

const formatPrice = (val: number) => `Rp${val.toLocaleString('id-ID')}`;
---

<section id="produk" class="bg-[#F5F5F5] px-2 py-6 sm:px-4 sm:py-8">
  

  

  {
    products.length === 0 && (
      <div class="bg-white px-5 py-10 text-center shadow-sm">
        <p class="text-sm font-semibold text-gray-800">Katalog sedang disiapkan</p>
        <p class="mx-auto mt-2 max-w-sm text-xs text-gray-500">
          Belum ada produk yang diterbitkan.
        </p>
      </div>
    )
  }

  <div id="product-grid" class="grid grid-cols-2 gap-2" hidden={products.length === 0}>
    {
      products.map((product, idx) => {
        const comparePrice = product.comparePrice ?? 0;
        const discount =
          comparePrice > product.price
            ? Math.round((1 - product.price / comparePrice) * 100)
            : 0;

        const sold = product.soldCount
          ? product.soldCount >= 10000
            ? `${(product.soldCount / 1000).toFixed(1).replace('.0', '')}RB Terjual`
            : `${product.soldCount} Terjual`
          : null;

        return (
          <a
            href={product.href}
            class="product-card group relative flex flex-col overflow-hidden rounded-lg bg-white shadow-sm ring-1 ring-slate-100 transition-all hover:shadow-md hover:ring-[#EE4D2D]/50"
            data-category={product.category}
            data-search={`${product.name} ${product.category} ${product.description}`.toLowerCase()}
            data-index={idx}
            style={idx >= 10 ? 'display: none;' : ''}
          >
            <div class="relative w-full aspect-square overflow-hidden bg-slate-50">
              <img
                src={product.image}
                alt={product.name}
                width="400"
                height="400"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading={idx < 4 ? 'eager' : 'lazy'}
                decoding="async"
              />
              {discount > 0 && (
                <div class="absolute right-0 top-0 flex flex-col items-center bg-[#FEEA2E]/90 px-1.5 py-1 backdrop-blur-xs rounded-bl-md z-10">
                  <span class="text-[10px] font-black leading-none text-[#EE4D2D]">{discount}%</span>
                  <span class="mt-0.5 rounded-sm bg-[#EE4D2D] px-1 py-[2px] text-[8px] font-bold leading-none text-white uppercase tracking-wider">OFF</span>
                </div>
              )}
            </div>

            <div class="flex flex-1 flex-col p-3">
              <h3 class="line-clamp-2 min-h-10 text-[13px] font-medium leading-5 text-slate-800">
                {product.name}
              </h3>
              {product.ratingValue && product.reviewCount && (
                <div class="mt-1 flex items-center gap-1">
                  <svg class="h-3 w-3 text-[#F59E0B]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                  </svg>
                  <span class="text-[11px] font-medium text-slate-600">{product.ratingValue.toFixed(1)}</span>
                  <span class="text-[10px] text-slate-400">({product.reviewCount})</span>
                </div>
              )}

              <div class="mt-auto pt-3">
                {discount > 0 && (
                  <div class="flex items-center gap-1.5 mb-0.5">
                    <span class="rounded bg-[#EE4D2D]/10 px-1 py-0.5 text-[9px] font-semibold text-[#EE4D2D]">HEMAT</span>
                    <span class="text-[11px] text-slate-400 line-through">
                      {formatPrice(comparePrice)}
                    </span>
                  </div>
                )}
                <div class="flex items-center justify-between">
                  <span class="text-base font-bold text-[#EE4D2D]">{formatPrice(product.price)}</span>
                  {sold && <span class="text-[10px] text-slate-500">{sold}</span>}
                </div>
              </div>
            </div>
          </a>
        );
      })
    }
  </div>

  <div
    id="load-more-container"
    class="mt-6 flex flex-col items-center gap-3"
    hidden={products.length === 0}
  >
    <p id="catalog-status" class="text-xs text-gray-500">
      Menampilkan <span id="product-visible-count">{Math.min(10, products.length)}</span> dari <span id="product-total-count">{products.length}</span> produk
    </p>
    {
      products.length > 10 && (
        <button
          type="button"
          id="load-more-btn"
          class="inline-flex w-full sm:w-auto min-w-[200px] items-center justify-center rounded-xl border border-slate-200 bg-white py-2.5 text-sm font-bold text-[#EE4D2D] shadow-sm transition-all hover:border-[#EE4D2D] hover:bg-[#FFF0ED] focus:outline-none focus:ring-2 focus:ring-[#EE4D2D] focus:ring-offset-1 active:scale-[0.98]"
        >
          Muat Lebih Banyak
        </button>
      )
    }
  </div>
</section>

<script>
  function initProductCatalog() {
    const searchInput = document.getElementById('catalog-search') as HTMLInputElement | null;
    const cards = document.querySelectorAll('.product-card') as NodeListOf<HTMLElement>;
    const loadMoreBtn = document.getElementById('load-more-btn');
    const visibleCountEl = document.getElementById('product-visible-count');
    const totalCountEl = document.getElementById('product-total-count');

    let currentSearch = '';
    let visibleLimit = 10;

    function filterAndRender() {
      let matchedCount = 0;
      let currentlyShown = 0;

      cards.forEach((card) => {
        const searchData = card.getAttribute('data-search') || '';
        const matchesSearch = !currentSearch || searchData.includes(currentSearch);

        if (matchesSearch) {
          matchedCount++;
          if (currentlyShown < visibleLimit) {
            card.style.display = 'flex';
            currentlyShown++;
          } else {
            card.style.display = 'none';
          }
        } else {
          card.style.display = 'none';
        }
      });

      if (visibleCountEl) visibleCountEl.textContent = String(currentlyShown);
      if (totalCountEl) totalCountEl.textContent = String(matchedCount);

      if (loadMoreBtn) {
        if (currentlyShown >= matchedCount) {
          loadMoreBtn.style.display = 'none';
        } else {
          loadMoreBtn.style.display = 'inline-flex';
        }
      }
    }

    searchInput?.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value.trim().toLowerCase();
      visibleLimit = 10;
      filterAndRender();
    });

    loadMoreBtn?.addEventListener('click', () => {
      visibleLimit += 10;
      filterAndRender();
    });

    filterAndRender();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductCatalog);
  } else {
    initProductCatalog();
  }
</script>
