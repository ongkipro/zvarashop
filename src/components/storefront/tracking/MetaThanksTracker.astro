---
import { META_EXTERNAL_ID_COOKIE } from '../../../lib/click-ids';
interface Props {
  tenantName: string;
  tenantSlug: string;
}

const { tenantName, tenantSlug } = Astro.props;
---

<script
  is:inline
  define:vars={{
    tenantName,
    tenantSlug,
    metaExternalIdCookie: META_EXTERNAL_ID_COOKIE,
  }}
>
  (() => {
    if (typeof window === 'undefined') return;

    const pushGtmEcomEvent =
      window.__PS_PUSH_GTM_ECOM__ ||
      ((event, payload) => {
        window.dataLayer = window.dataLayer || [];
        window.dataLayer.push({ ecommerce: null });
        window.dataLayer.push({
          event,
          tracking_owner: 'app',
          meta_managed_by_app: true,
          meta_event_id: payload.event_id,
          ecommerce: {
            currency: payload.currency || 'IDR',
            value: Number(payload.value || 0),
            transaction_id: payload.transaction_id,
            items: [
              {
                item_id: payload.item_id || '',
                item_name: payload.item_name || '',
                item_variant: payload.item_variant,
                quantity: 1,
              },
            ],
          },
        });
      });

    const hashSha256Hex = async (input) => {
      const normalized = String(input || '')
        .trim()
        .toLowerCase();
      if (!normalized || !globalThis.crypto?.subtle) return '';
      const bytes = new TextEncoder().encode(normalized);
      const digest = await crypto.subtle.digest('SHA-256', bytes);
      return Array.from(new Uint8Array(digest))
        .map((b) => b.toString(16).padStart(2, '0'))
        .join('');
    };

    if (new URLSearchParams(window.location.search).get('preview') === '1') return;
    let state = null;
    try {
      state = JSON.parse(sessionStorage.getItem('thanks_state') || 'null');
    } catch {}

    const pick = (key, fallback = '') => String(state?.[key] ?? fallback);
    const pickNum = (key, fallback = 0) => Number(state?.[key] ?? fallback);
    // Read the guard before the event goes out, write it after. `once()` used to
    // do both at the moment the tracker *decided* to fire, so a page that died
    // before the deferred pixel flushed — or a browser that threw on a
    // localStorage write — burned the order permanently on BOTH legs. Meta
    // deduplicates on event_id and `capi_event_outbox.event_id` is UNIQUE, so a
    // retry on a later visit is idempotent; a lost conversion is not.
    const guardKey = (key) => `meta_once_${key}`;
    const alreadyFired = (key) => {
      try {
        return localStorage.getItem(guardKey(key)) === '1';
      } catch {
        return false;
      }
    };
    const markFired = (key) => {
      try {
        localStorage.setItem(guardKey(key), '1');
        sessionStorage.setItem(guardKey(key), '1');
      } catch {}
    };
    const getCookieValue = (name) =>
      document.cookie
        .split('; ')
        .find((row) => row.startsWith(`${name}=`))
        ?.split('=')[1] || '';

    const postMeta = (payload) => {
      fetch('/api/meta-event', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      }).catch(() => {});
    };

    // event_id dipakai untuk event funnel awal (ViewContent/AddToCart/InitiateCheckout).
    // Purchase TIDAK memakai id buatan browser: server CAPI selalu memakai
    // order_number sebagai event_id (lihat resolveMetaEventId), jadi leg browser
    // wajib memakai order_number yang sama - dibaca ulang dari /api/order-status
    // di dalam fire() supaya dua leg mengutip baris order yang sama.
    const orderId = pick('order_id', '');
    const productName = pick('product_name', tenantName);
    // Product ID is the catalog identity published by both feeds. Variant ID is
    // retained separately for checkout and reporting, never folded into it.
    const productId = pick('product_id', '');
    let contentIds = productId ? [productId] : [];
    const phone = pick('phone', '');
    const name = pick('name', '');
    const province = pick('province', '');
    const city = pick('city', '');
    const district = pick('district', '');
    const postalCode = pick('postal_code', '');
    const productPrice = pickNum('product_price', pickNum('value', 1));
    const quantity = Math.max(1, pickNum('quantity', 1));
    let conversionValue = productPrice * quantity;
    let verifiedPaymentStatus = pick('payment_status', '').toLowerCase();
    const eventName = 'Purchase';


    const paymentMethod = pick('pm', pick('payment_method', 'cod')).toLowerCase();

    const data = {
      content_name: productName,
      content_ids: contentIds.length ? contentIds : undefined,
      content_type: 'product',
      value: Number(conversionValue || 1),
      currency: 'IDR',
    };

    // Kept byte-identical to `src/lib/meta-identity.ts`, which the server CAPI
    // leg uses. This script cannot import it — `define:vars` forces
    // `is:inline`, which Astro never bundles — so `meta-identity.test.ts`
    // reads this file and fails if the two drift apart.
    const normalizeMetaText = (value) => {
      const cleaned = String(value || '').trim().toLowerCase().replace(/[^a-z0-9]/g, '');
      return cleaned || undefined;
    };
    const toE164Digits = (value) => {
      let digits = String(value || '').replace(/\D/g, '');
      if (!digits) return undefined;
      if (digits.startsWith('00')) digits = digits.slice(2);
      if (digits.startsWith('620')) digits = `62${digits.slice(3)}`;
      else if (digits.startsWith('0')) digits = `62${digits.slice(1)}`;
      else if (digits.startsWith('8')) digits = `62${digits}`;
      return digits.length >= 8 && digits.length <= 15 ? digits : undefined;
    };
    const nameParts = String(name || '').trim().split(/\s+/).filter(Boolean);
    const normalizedPhone = toE164Digits(phone);
    const storedExternalId = getCookieValue(metaExternalIdCookie);
    const externalId = /^[a-f0-9]{32}$/.test(storedExternalId)
      ? storedExternalId
      : normalizedPhone;
    const firstName = normalizeMetaText(nameParts[0]);
    const lastName = nameParts.length > 1 ? normalizeMetaText(nameParts.slice(1).join('')) : undefined;
    // The CAPI leg below (postMeta's user_data) hashes ct/st/zp/country on
    // this exact Purchase already. Dropping them from the browser Pixel leg
    // — as this used to — sent Meta two different match keys for the same
    // order: a full one server-side, a phone-and-name-only one client-side.
    const metaCity = normalizeMetaText(city);
    const metaState = normalizeMetaText(province);
    const metaZip = normalizeMetaText(postalCode);
    // Indonesia. `id` is its ISO 3166-1 alpha-2 code, which is what Meta's
    // customer information parameters require — "use the lowercase, 2-letter
    // country codes in ISO 3166-1 alpha-2", re-verified 2026-08-28. It is a
    // country code, not an identifier, and it is never the full country name:
    // this value is SHA-256'd, so `indonesia` would hash to a key matching
    // nobody, silently. Google wants the same country in uppercase (`ID`),
    // which is why the enhanced-conversions block below does not reuse this.
    const metaCountry = normalizeMetaText('id');

    // Identity is known from sessionStorage at page load — it does not depend on
    // the order-status round trip — so the Pixel is initialised with it straight
    // away. This used to run inside fire() as a *second* `fbq('init', pixelId,
    // …)`, and fbevents ignores every init after the first: the hashes below
    // were computed on every Purchase and discarded on every Purchase, leaving
    // the browser leg matching on `external_id` alone.
    const pixelReady = (async () => {
      const advancedMatching = {
        ph: normalizedPhone ? await hashSha256Hex(normalizedPhone) : undefined,
        fn: firstName ? await hashSha256Hex(firstName) : undefined,
        ln: lastName ? await hashSha256Hex(lastName) : undefined,
        ct: metaCity ? await hashSha256Hex(metaCity) : undefined,
        st: metaState ? await hashSha256Hex(metaState) : undefined,
        zp: metaZip ? await hashSha256Hex(metaZip) : undefined,
        country: metaCountry ? await hashSha256Hex(metaCountry) : undefined,
        external_id: externalId ? await hashSha256Hex(externalId) : undefined,
      };
      if (typeof window.__PS_META_INIT__ === 'function') {
        window.__PS_META_INIT__(advancedMatching);
      }
      // fbevents is deferred behind a 2.5 s timer for pages that are measured on
      // speed. This one is measured on conversions, and the buyer is one tap
      // from WhatsApp, so the download starts now and overlaps the verification
      // fetch instead of queueing behind it.
      if (typeof window.__PS_LOAD_META_PIXEL__ === 'function') {
        window.__PS_LOAD_META_PIXEL__();
      }
    })().catch((error) => {
      console.error('meta-browser-matching', error);
    });

    const fire = async () => {
      // Every Purchase must resolve to a server-known order. Online orders must
      // additionally be paid; browser state is never authoritative.
      const orderPk = pick('order_pk', '');
      const statusToken = pick('status_token', '');
      if (!orderPk || !statusToken) return;
      // Guard 2, read early: a refresh or a revisit must not cost another
      // /api/order-status round trip on top of not firing.
      if (orderId && alreadyFired(`${eventName}_order_${orderId}`)) return;
      let finalEventId = '';
      try {
        const resp = await fetch('/api/order-status', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ order_pk: orderPk, status_token: statusToken }),
          cache: 'no-store',
        });
        const statusData = await resp.json().catch(() => ({}));
        if (!resp.ok || !statusData?.success) return;
        // The event_id for both legs. The server CAPI leg substitutes this exact
        // column, so an order that cannot be resolved gets no Purchase at all -
        // firing a browser-minted id here would be an undeduplicatable double count.
        finalEventId = String(statusData.order_number || '').trim();
        if (!finalEventId) return;
        verifiedPaymentStatus = String(statusData.payment_status || verifiedPaymentStatus).toLowerCase();
        if (paymentMethod !== 'cod' && !statusData.is_paid) return;
        // Report the goods, not the invoice. `product_value` is the chosen
        // variant's price times its quantity, summed from `order_items` — it
        // excludes shipping, the COD service fee and its VAT, and the payment
        // channel's admin fee. Optimising on those would have the platform
        // bidding on the courier's price list as if it were margin.
        //
        // Still taken from the server rather than the browser: a tampered
        // sessionStorage must not be able to dictate reported revenue.
        const serverProductValue = Number(statusData.product_value || 0);
        if (serverProductValue > 0) {
          conversionValue = serverProductValue;
          // `data` was built before this fetch, so the pixel payload has to be
          // corrected too or the two legs would report different revenue.
          data.value = serverProductValue;
        }
        const serverContentIds = Array.isArray(statusData.content_ids)
          ? statusData.content_ids.filter((id) => typeof id === 'string' && /^\d{5,16}$/.test(id))
          : [];
        if (!serverContentIds.length) return;
        contentIds = serverContentIds;
        data.content_ids = serverContentIds;
      } catch {
        return;
      }
      // Guard 1: cegah event success dobel untuk event yang sama.
      if (alreadyFired(`${eventName}_${finalEventId}`)) return;

      // The Pixel's one init already carries this buyer's match keys. Awaiting
      // `pixelReady` only proves `__PS_META_INIT__` was *called* — the init it
      // schedules lands a microtask later — so the Purchase goes out through
      // the hook that waits for the init to have actually been issued rather
      // than relying on the verification fetch above having taken long enough.
      await pixelReady;
      if (typeof window.__PS_META_TRACK__ === 'function') {
        window.__PS_META_TRACK__(eventName, data, { eventID: finalEventId });
      }

      try {
        pushGtmEcomEvent('purchase', {
          currency: 'IDR',
          value: Number(conversionValue || 1),
          item_id: contentIds[0] || productId,
          item_name: productName,
          item_variant: pick('variant_unique_id', '') || undefined,
          transaction_id: orderId || undefined,
          event_id: finalEventId,
        });
      } catch (error) {
        console.error('gtm-purchase', error);
      }

      try {
        if (typeof window.__PS_PUSH_GOOGLE_CONVERSION__ === 'function') {
          // Google normalises differently from Meta: trim and lowercase only.
          // Meta additionally strips every non-alphanumeric, which collapses a
          // multi-word Indonesian family name ("Nur Aisyah" -> "nuraisyah") into
          // something no Google account carries. Reusing the Meta values here is
          // what this leg used to do.
          const googleText = (value) => {
            const cleaned = String(value || '').trim().toLowerCase();
            return cleaned || undefined;
          };
          const googleFirstName = googleText(nameParts[0]);
          const googleLastName = nameParts.length > 1 ? googleText(nameParts.slice(1).join(' ')) : undefined;
          const googleUserData = {
            // Google matches on E.164 including the leading '+'; Meta matches on
            // digits only. Same number, two different hashes — do not share one.
            sha256_phone_number: normalizedPhone ? await hashSha256Hex(`+${normalizedPhone}`) : undefined,
            // Names belong inside `address`. Sent at the top level — as they were
            // — gtag ignores them, so the hashes cost work and match nobody.
            // `postal_code` and `country` travel unhashed beside them, and Google
            // treats name plus those two as one address match key.
            address: {
              sha256_first_name: googleFirstName ? await hashSha256Hex(googleFirstName) : undefined,
              sha256_last_name: googleLastName ? await hashSha256Hex(googleLastName) : undefined,
              city: googleText(city),
              region: googleText(province),
              postal_code: googleText(postalCode),
              // ISO 3166-1 alpha-2, uppercase per Google's enhanced-conversions
              // documentation (support.google.com/google-ads/answer/13258081,
              // whose own example is 'UK') — unlike Meta's `country`, which wants
              // lowercase. Two different ad platforms, two different cases; do
              // not let one leg's normaliser bleed into the other's.
              country: 'ID',
            },
          };
          window.__PS_PUSH_GOOGLE_CONVERSION__(Number(conversionValue || 1), orderId || undefined, googleUserData);
        }
      } catch (error) {
        console.error('google-ads-purchase', error);
      }

      postMeta({
        event_name: eventName,
        event_id: finalEventId,
        // The order reference the server re-resolves the Purchase from. Sent
        // explicitly instead of leaving the route to parse the address bar.
        order_number: finalEventId,
        status_token: statusToken,
        lp_name: pick('lp_name', ''),
        content_ids: contentIds.length ? contentIds : undefined,
        content_name: productName,
        value: Number(conversionValue || 1),
        currency: 'IDR',
        content_type: 'product',
        event_source_url: window.location.href,
        user_data: {
          customer_name: name,
          customer_phone: phone,
          country: 'id',
          postal_code: postalCode,
          province,
          city,
          district,
          // Stable first-party visitor ID when available; normalized phone only
          // keeps an upgrading session matchable before the cookie exists.
          external_id: externalId || undefined,
          fbp: getCookieValue('_fbp'),
          fbc: getCookieValue('_fbc'),
        },
        payment_status: verifiedPaymentStatus,
      });

      // Claim the order only now that every leg has been handed off. Written
      // before the dispatch — as it was — an interrupted page kept the claim and
      // lost the conversion; a revisit could never recover it.
      markFired(`${eventName}_${finalEventId}`);
      if (orderId) markFired(`${eventName}_order_${orderId}`);
    };

    void fire();
  })();
</script>
