---
import { getStoreAdsConfig } from '../../../lib/store-ads';
import { META_EXTERNAL_ID_COOKIE } from '../../../lib/click-ids';

interface Props {
  pixelId?: string;
}

const { pixelId: pixelIdProp } = Astro.props;

let pixelId = pixelIdProp;
if (pixelId === undefined) {
  const adsConfig = await getStoreAdsConfig(Astro.locals);
  pixelId = adsConfig.metaPixelId;
}
const shouldRenderPixel = /^\d{5,25}$/.test(String(pixelId || '').trim());
---

{shouldRenderPixel && (
  <>
    {/* fbevents.js and the pixel config together cost roughly 220 KB from a
        third-party origin, and the connection is only opened once the inline
        loader runs. Warming DNS, TCP and TLS here removes that round trip from
        the critical path. Rendered only when a pixel is actually configured. */}
    <link rel="preconnect" href="https://connect.facebook.net" crossorigin />
    <link rel="dns-prefetch" href="https://connect.facebook.net" />
    <script is:inline define:vars={{ pixelId, metaExternalIdCookie: META_EXTERNAL_ID_COOKIE }}>
      // Deliberately synchronous. Everything another script may call —
      // `__META_PIXEL_ID__`, `__PS_LOAD_META_PIXEL__`, `__PS_META_INIT__` — is
      // installed before this returns, so a page tracker can never win a race
      // against an `await` in here and find the hook missing. Only the
      // external-ID hash is asynchronous, and `__PS_META_INIT__` waits on it
      // internally.
      (() => {
        if (typeof window === 'undefined') return;

        const createEventId = (prefix) => `${prefix}_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
        const eventId = createEventId('pv');
        window.__META_PAGEVIEW_EVENT_ID__ = eventId;

        const readCookieValue = (name) =>
          document.cookie
            .split('; ')
            .find((row) => row.startsWith(`${name}=`))
            ?.split('=')[1] || '';
        const cookieSecurity = window.location.protocol === 'https:'
          ? 'SameSite=None; Secure'
          : 'SameSite=Lax';
        const writeMetaCookie = (name, value) => {
          document.cookie =
            `${name}=${value}; Path=/; Max-Age=${90 * 24 * 60 * 60}; ${cookieSecurity}`;
        };

        // Meta's own Conversions API Parameter Builder creates `_fbp` before
        // the Pixel library is available. Do the same at the first-party page
        // boundary so the immediately posted PageView/ViewContent CAPI events
        // carry the same browser ID that fbevents.js will later read. Waiting
        // for the deferred 105 KB library left almost every first event without
        // fbp even though the browser leg eventually had one.
        let fbp = readCookieValue('_fbp');
        if (!/^fb\.\d\.\d{10,20}\..+$/.test(fbp)) {
          let randomPart = '';
          try {
            randomPart = Array.from(crypto.getRandomValues(new Uint32Array(2))).join('');
          } catch {
            randomPart = String(Math.floor(Math.random() * 1_000_000_000_000_000));
          }
          fbp = `fb.1.${Date.now()}.${randomPart}`;
          writeMetaCookie('_fbp', fbp);
        }

        let externalId = readCookieValue(metaExternalIdCookie);
        if (!/^[a-f0-9]{32}$/.test(externalId)) {
          externalId = '';
          try {
            externalId = Array.from(crypto.getRandomValues(new Uint8Array(16)))
              .map((byte) => byte.toString(16).padStart(2, '0'))
              .join('');
          } catch {
            // Pixel and CAPI still carry fbp/fbc when Web Crypto is unavailable.
          }
          if (externalId) {
            writeMetaCookie(metaExternalIdCookie, externalId);
          }
        }

        const externalIdHashReady = (async () => {
          if (!externalId) return undefined;
          try {
            const digest = await crypto.subtle.digest(
              'SHA-256',
              new TextEncoder().encode(externalId),
            );
            return Array.from(new Uint8Array(digest))
              .map((byte) => byte.toString(16).padStart(2, '0'))
              .join('');
          } catch {
            // Pixel and CAPI still carry fbp/fbc when Web Crypto is unavailable.
            return undefined;
          }
        })();

        // Meta's own stub queues every fbq() call until the script arrives, so
        // the queue is created now and the 105 KB download is deferred. The
        // events, their order and their event IDs are unchanged; only the
        // moment the network request happens moves off the critical path,
        // where it and the pixel config were costing about 520 KB on a product
        // page.
        (function (f) {
          if (f.fbq) return;
          const n = (f.fbq = function () {
            n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
          });
          if (!f._fbq) f._fbq = n;
          n.push = n;
          n.loaded = true;
          n.version = '2.0';
          n.queue = [];
        })(window);

        let requested = false;
        const loadPixel = () => {
          if (requested) return;
          requested = true;
          const script = document.createElement('script');
          script.async = true;
          script.src = 'https://connect.facebook.net/en_US/fbevents.js';
          document.head.appendChild(script);
        };

        // Whichever comes first. The interaction path covers anyone who stays;
        // the timeout covers a visitor who reads and leaves without touching
        // anything, so a bounce is still counted rather than traded away.
        for (const type of ['pointerdown', 'keydown', 'touchstart', 'scroll']) {
          window.addEventListener(type, loadPixel, { once: true, passive: true });
        }
        // A plain timer, deliberately. `requestIdleCallback` was tried first and
        // does not defer anything: its `timeout` is a ceiling, not a floor, so
        // on a page this light it fired at 245 ms and the download landed
        // almost exactly where it had been.
        window.setTimeout(loadPixel, 2500);
        // A conversion must never wait on that timer, exactly as
        // `__PS_LOAD_GOOGLE_TAG__` exists so the Google leg never does.
        // `MetaThanksTracker` calls this the moment it knows it is on a
        // confirmation page, so the 105 KB library downloads while the order is
        // still being verified instead of after it.
        window.__PS_LOAD_META_PIXEL__ = loadPixel;

        window.__META_PIXEL_ID__ = pixelId;

        // fbevents accepts `init` for a given pixel id exactly ONCE and silently
        // ignores every later call, advanced matching included. Verified against
        // the live library on 2026-08-28: a second `fbq('init', id, {ph, fn})`
        // left `pixelsByID[id].userData` as the `{external_id}` the first init
        // set. So there is one init, it carries the fullest identity the page
        // can supply, and no other file may call it — `__PS_META_INIT__` is how
        // a page contributes to it.
        let initialised = false;
        window.__PS_META_INIT__ = (advancedMatching) => {
          if (initialised) return;
          initialised = true;
          void externalIdHashReady.then((externalIdHash) => {
            const userData = externalIdHash ? { external_id: externalIdHash } : {};
            for (const key of Object.keys(advancedMatching || {})) {
              if (advancedMatching[key]) userData[key] = advancedMatching[key];
            }
            if (Object.keys(userData).length) window.fbq('init', pixelId, userData);
            else window.fbq('init', pixelId);
            window.fbq('track', 'PageView', {}, { eventID: eventId });
          });
        };

        // A page that knows who the visitor is declares it before this script
        // runs and inits itself once its hashes are ready. The timer is the
        // backstop: a tracker that bails out — no order state, `?preview=1` —
        // must not cost the page its PageView.
        if (window.__PS_META_AWAIT_MATCHING__) {
          window.setTimeout(() => window.__PS_META_INIT__(), 1500);
        } else {
          window.__PS_META_INIT__();
        }
      })();
    </script>
    <noscript>
      <img
        height="1"
        width="1"
        style="display:none"
        src={`https://www.facebook.com/tr?id=${encodeURIComponent(pixelId)}&ev=PageView&noscript=1`}
        alt=""
      />
    </noscript>
  </>
)}
